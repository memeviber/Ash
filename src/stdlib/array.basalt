// Owning, growable generic array implemented in Basalt. The compiler does not
// provide array-specific operations here: only the minimal memory intrinsics
// are used as the checked allocation boundary.
namespace array {
  struct Array<T> {
    data: T*;
    len: int;
    cap: int;
  }

  func new<T>(capacity: int, zero: T): Array<T> {
    let a: Array<T> = 0;
    let cap: int = capacity;
    if cap < 1 then cap = 4;
    a.data = memory_alloc(cap, zero);
    a.len = 0;
    a.cap = cap;
    return a;
  }

  func new_aligned<T>(capacity: int, alignment: int, zero: T): Array<T> {
    let a: Array<T> = 0;
    let cap: int = capacity;
    if cap < 1 then cap = 4;
    a.data = memory_alloc_aligned(cap, alignment, zero);
    a.len = 0;
    a.cap = cap;
    return a;
  }

  func reserve<T>(a: Array<T>, minimum: int, zero: T): Array<T> {
    if minimum < 1 then return a;
    if minimum > a.cap then {
      a.data = memory_resize(a.data, a.cap, minimum, zero);
      a.cap = minimum;
    }
    return a;
  }

  func ensure_capacity<T>(a: Array<T>, required: int, zero: T): Array<T> {
    if required < 1 then return a;
    if required < a.cap then return a;
    if required == a.cap then return a;
    let next: int = a.cap;
    if next < 1 then next = 4;
    while next < required {
      let grown: int = next * 2;
      if grown < next then { grown = required; }
      next = grown;
    }
    return array::reserve(a, next, zero);
  }

  func push<T>(a: Array<T>, value: T, zero: T): Array<T> {
    a = array::ensure_capacity(a, a.len + 1, zero);
    a.data[a.len] = value;
    a.len = a.len + 1;
    return a;
  }

  func get<T>(a: Array<T>, index: int): T {
    return a.data[index];
  }

  func in_bounds<T>(a: Array<T>, index: int): bool {
    if index < 0 then return false;
    return index < a.len;
  }

  func get_or<T>(a: Array<T>, index: int, fallback: T): T {
    if index < 0 then return fallback;
    if index < a.len then return array::get(a, index);
    return fallback;
  }

  func set_if_in_bounds<T>(a: Array<T>, index: int, value: T): bool {
    if index < 0 then return false;
    if index < a.len then {
      a.data[index] = value;
      return 1;
    }
    return 0;
  }

  func set<T>(a: Array<T>, index: int, value: T): Array<T> {
    a.data[index] = value;
    return a;
  }

  func clear<T>(a: Array<T>): Array<T> {
    a.len = 0;
    return a;
  }

  func length<T>(a: Array<T>): int {
    return a.len;
  }

  func len<T>(a: Array<T>): int {
    return a.len;
  }

  func capacity<T>(a: Array<T>): int {
    return a.cap;
  }

  func is_empty<T>(a: Array<T>): bool {
    return a.len == 0;
  }

  func is_full<T>(a: Array<T>): bool {
    return a.cap < a.len || a.cap == a.len;
  }

  func free<T>(a: Array<T>): Array<T> {
    if a.data != 0 then memory_free(a.data);
    a.data = 0;
    a.len = 0;
    a.cap = 0;
    return a;
  }

  // Return an owning copy of a bounded range. Negative start/count values are
  // clamped to zero, and ranges extending past the end are truncated.
  func slice<T>(a: Array<T>, start: int, count: int, zero: T): Array<T> {
    let begin: int = start;
    if begin < 0 then begin = 0;
    if begin > a.len then begin = a.len;
    let take: int = count;
    if take < 0 then take = 0;
    if take > a.len - begin then take = a.len - begin;
    let out: Array<T> = array::new(take, zero);
    let i: int = 0;
    while i < take {
      out = array::push(out, array::get(a, begin + i), zero);
      i = i + 1;
    }
    return out;
  }

  // Allocate a new array and transform every input element with a callback.
  func map<T, U>(a: Array<T>, transform: fn(T): U, zero_u: U): Array<U> {
    let out: Array<U> = array::new(a.len, zero_u);
    let i: int = 0;
    while i < a.len {
      out = array::push(out, transform(array::get(a, i)), zero_u);
      i = i + 1;
    }
    return out;
  }

  // Stable in-place insertion sort. Equal elements retain their input order.
  func sort_stable<T>(a: Array<T>, before: fn(T, T): bool): Array<T> {
    let i: int = 1;
    while i < a.len {
      let value: T = a.data[i];
      let j: int = i;
      while j > 0 && before(value, a.data[j - 1]) {
        a.data[j] = a.data[j - 1];
        j = j - 1;
      }
      a.data[j] = value;
      i = i + 1;
    }
    return a;
  }

  // Keep elements for which predicate returns true.
  func filter<T>(a: Array<T>, predicate: fn(T): bool, zero: T): Array<T> {
    let out: Array<T> = array::new(a.len, zero);
    let i: int = 0;
    while i < a.len {
      let value: T = array::get(a, i);
      if predicate(value) then out = array::push(out, value, zero);
      i = i + 1;
    }
    return out;
  }
}
