namespace result {
  // Result<T, E> is a fully materialized tagged value. Both payloads are
  // initialized by ok() and err() so inspection never reads an uninitialized
  // field and all public operations are total. For standard-library APIs,
  // E=int follows one convention: error::success (0) means success and every
  // failure carries a nonzero, module-documented error category.
  struct Result<T, E> {
    ok: int;
    value: T;
    error: E;
  }

  func ok<T, E>(value: T, error_zero: E): Result<T, E> {
    let r: Result<T, E> = 0;
    r.ok = 1;
    r.value = value;
    r.error = error_zero;
    return r;
  }

  func err<T, E>(value_zero: T, error: E): Result<T, E> {
    let r: Result<T, E> = 0;
    r.ok = 0;
    r.value = value_zero;
    r.error = error;
    return r;
  }

  func is_ok<T, E>(r: Result<T, E>): int { return r.ok; }
  func is_err<T, E>(r: Result<T, E>): int { return r.ok == 0; }

  func unwrap_or<T, E>(r: Result<T, E>, fallback: T): T {
    if r.ok == 1 then { return r.value; }
    return fallback;
  }

  func value_or<T, E>(r: Result<T, E>, fallback: T): T {
    return result::unwrap_or(r, fallback);
  }

  func error_or<T, E>(r: Result<T, E>, fallback: E): E {
    if r.ok == 0 then { return r.error; }
    return fallback;
  }

  func map<T, U, E>(r: Result<T, E>, transform: fn(T): U, value_zero: U): Result<U, E> {
    if r.ok == 1 then return result::ok(transform(r.value), r.error);
    return result::err(value_zero, r.error);
  }

  func map_or<T, U, E>(r: Result<T, E>, fallback: U, transform: fn(T): U): U {
    if r.ok == 1 then return transform(r.value);
    return fallback;
  }

  func map_error<T, E, F>(r: Result<T, E>, transform: fn(E): F, error_zero: F): Result<T, F> {
    if r.ok == 1 then return result::ok(r.value, error_zero);
    return result::err(r.value, transform(r.error));
  }

  func map_error_or<T, E, F>(r: Result<T, E>, fallback: F, transform: fn(E): F): F {
    if r.ok == 0 then return transform(r.error);
    return fallback;
  }

  func contains<T, E>(r: Result<T, E>, value: T): bool {
    if r.ok == 0 then return false;
    return r.value == value;
  }

  func and_result<T, U, E>(r: Result<T, E>, next: Result<U, E>, value_zero: U): Result<U, E> {
    if r.ok == 1 then return next;
    return result::err(value_zero, r.error);
  }

  func or_result<T, E, F>(r: Result<T, E>, next: Result<T, F>, error_zero: F): Result<T, F> {
    if r.ok == 1 then return result::ok(r.value, error_zero);
    return next;
  }

}
