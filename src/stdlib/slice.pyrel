namespace slice {
  // Owning, growable generic slice. The backing storage is typed, so every
  // Pyrel element type uses the same allocation and growth path.
  struct Slice<T> {
    zero: T;
    data: T*;
    len: int;
    cap: int;
  }

  func with_capacity<T>(capacity: int, zero: T): Slice<T> {
    let s: Slice<T> = 0;
    let cap: int = capacity;
    if cap < 1 then cap = 4;
    s.zero = zero;
    s.data = memory_alloc(cap, zero);
    s.len = 0;
    s.cap = cap;
    return s;
  }

  func new<T>(zero: T): Slice<T> {
    return slice::with_capacity(4, zero);
  }

  func reserve<T>(s: Slice<T>, minimum: int): Slice<T> {
    if minimum < 1 then return s;
    if minimum > s.cap then {
      s.data = memory_resize(s.data, s.cap, minimum, s.zero);
      s.cap = minimum;
    }
    return s;
  }

  func ensure_capacity<T>(s: Slice<T>, required: int): Slice<T> {
    if required < 1 then return s;
    if required < s.cap then return s;
    if required == s.cap then return s;
    let next: int = s.cap;
    if next < 1 then next = 4;
    while next < required {
      let grown: int = next * 2;
      if grown < next then { grown = required; }
      if grown == next then { grown = required; }
      next = grown;
    }
    return slice::reserve(s, next);
  }

  func push<T>(s: Slice<T>, value: T): Slice<T> {
    s = slice::ensure_capacity(s, s.len + 1);
    s.data[s.len] = value;
    s.len = s.len + 1;
    return s;
  }

  func in_bounds<T>(s: Slice<T>, index: int): bool {
    if index < 0 then return false;
    return index < s.len;
  }

  func get_or<T>(s: Slice<T>, index: int, fallback: T): T {
    if slice::in_bounds(s, index) then return s.data[index];
    return fallback;
  }

  func get<T>(s: Slice<T>, index: int): T {
    return slice::get_or(s, index, s.zero);
  }

  func set_if_in_bounds<T>(s: Slice<T>, index: int, value: T): Slice<T> {
    if slice::in_bounds(s, index) then s.data[index] = value;
    return s;
  }

  func set<T>(s: Slice<T>, index: int, value: T): Slice<T> {
    return slice::set_if_in_bounds(s, index, value);
  }

  func pop_or<T>(s: Slice<T>, fallback: T): Slice<T> {
    if s.len > 0 then s.len = s.len - 1;
    return s;
  }

  func last_or<T>(s: Slice<T>, fallback: T): T {
    if s.len < 1 then return fallback;
    return slice::get_or(s, s.len - 1, fallback);
  }

  func clear<T>(s: Slice<T>): Slice<T> { s.len = 0; return s; }
  func length<T>(s: Slice<T>): int { return s.len; }
  func capacity<T>(s: Slice<T>): int { return s.cap; }
  func is_empty<T>(s: Slice<T>): bool { return s.len == 0; }
  func is_full<T>(s: Slice<T>): bool { return s.cap < s.len || s.cap == s.len; }

  func free<T>(s: Slice<T>): void {
    memory_free(s.data);
    s.data = 0;
    s.len = 0;
    s.cap = 0;
  }

  // Compatibility API for code that explicitly uses the int allocator.
  struct IntSlice {
    data: int*;
    len: int;
    cap: int;
  }

  func new_int(capacity: int): IntSlice {
    let s: IntSlice = 0;
    if capacity < 1 then capacity = 1;
    s.data = alloc_ints(capacity);
    s.len = 0;
    s.cap = capacity;
    return s;
  }

  func push_int(s: IntSlice, value: int): IntSlice {
    if s.cap < s.len || s.cap == s.len then {
      let next: int = s.cap + s.cap;
      if next < 1 then next = 1;
      s.data = grow_ints(s.data, s.cap, next);
      s.cap = next;
    }
    s.data[s.len] = value;
    s.len = s.len + 1;
    return s;
  }

  func get_int_or(s: IntSlice, index: int, fallback: int): int {
    if index < 0 || index == s.len || index > s.len then return fallback;
    return s.data[index];
  }

  func get_int(s: IntSlice, index: int): int { return slice::get_int_or(s, index, 0); }

  func set_int(s: IntSlice, index: int, value: int): IntSlice {
    if (index == 0 || index > 0) && index < s.len then s.data[index] = value;
    return s;
  }

  func pop_int(s: IntSlice): IntSlice {
    if s.len > 0 then s.len = s.len - 1;
    return s;
  }

  func clear_int(s: IntSlice): IntSlice { s.len = 0; return s; }
  func length_int(s: IntSlice): int { return s.len; }
  func capacity_int(s: IntSlice): int { return s.cap; }
  func free_int(s: IntSlice): void { free_ints(s.data); }
}
