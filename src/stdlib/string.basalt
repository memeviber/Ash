namespace str {
  func byte_len(s: string): int {
    let i: int = 0;
    while s[i] != '\0' {
      i = i + 1;
    }
    return i;
  }

  func len(s: string): int {
    return byte_len(s);
  }

  func byte_at(s: string, index: int): int {
    return s[index] & 255;
  }

  func eq(a: string, b: string): int {
    let i: int = 0;
    while a[i] != '\0' && b[i] != '\0' {
      if a[i] != b[i] then { return 0; }
      i = i + 1;
    }
    return a[i] == b[i];
  }

  func equals(a: string, b: string): int {
    return eq(a, b);
  }

  func concat(a: string, b: string): string {
    return a ++ b;
  }

  // UTF-8 helpers. byte_len and byte_at are byte-oriented; codepoint_* APIs are UTF-8 aware.

  func utf8_decode_at(s: string, offset: int): int {
    let n: int = byte_len(s);
    if offset < 0 then { return (0 - 1); }
    if offset > (n - 1) then { return (0 - 1); }
    let b0: int = byte_at(s, offset);
    if b0 < 128 then { return b0; }
    if b0 > 193 && b0 < 224 then {
      if offset + 1 > (n - 1) then { return (0 - 1); }
      let b1: int = byte_at(s, offset + 1);
      if b1 < 128 || b1 > 191 then { return (0 - 1); }
      return (b0 - 192) * 64 + (b1 - 128);
    }
    if b0 > 223 && b0 < 240 then {
      if offset + 2 > (n - 1) then { return (0 - 1); }
      let b1: int = byte_at(s, offset + 1);
      let b2: int = byte_at(s, offset + 2);
      if b1 < 128 || b1 > 191 || b2 < 128 || b2 > 191 then { return (0 - 1); }
      let cp: int = (b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128);
      if cp < 2048 then { return (0 - 1); }
      if cp > 55295 && cp < 57344 then { return (0 - 1); }
      return cp;
    }
    if b0 > 239 && b0 < 245 then {
      if offset + 3 > (n - 1) then { return (0 - 1); }
      let b1: int = byte_at(s, offset + 1);
      let b2: int = byte_at(s, offset + 2);
      let b3: int = byte_at(s, offset + 3);
      if b1 < 128 || b1 > 191 || b2 < 128 || b2 > 191 || b3 < 128 || b3 > 191 then { return (0 - 1); }
      let cp: int = (b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128);
      if cp < 65536 || cp > 1114111 then { return (0 - 1); }
      return cp;
    }
    return (0 - 1);
  }

  func utf8_next(s: string, offset: int): int {
    let cp: int = utf8_decode_at(s, offset);
    if cp < 0 then { return (0 - 1); }
    let b0: int = byte_at(s, offset);
    if b0 < 128 then { return offset + 1; }
    if b0 < 224 then { return offset + 2; }
    if b0 < 240 then { return offset + 3; }
    return offset + 4;
  }

  func utf8_validate(s: string): bool {
    let n: int = byte_len(s);
    let offset: int = 0;
    while offset < n {
      offset = utf8_next(s, offset);
      if offset < 0 then { return false; }
    }
    return true;
  }

  func codepoint_len(s: string): int {
    let n: int = byte_len(s);
    let offset: int = 0;
    let count: int = 0;
    while offset < n {
      offset = utf8_next(s, offset);
      if offset < 0 then { return (0 - 1); }
      count = count + 1;
    }
    return count;
  }

  func codepoint_byte_offset(s: string, index: int): int {
    if index < 0 then { return (0 - 1); }
    let n: int = byte_len(s);
    let offset: int = 0;
    let count: int = 0;
    while offset < n {
      if count == index then { return offset; }
      offset = utf8_next(s, offset);
      if offset < 0 then { return (0 - 1); }
      count = count + 1;
    }
    if count == index then { return offset; }
    return (0 - 1);
  }

  func codepoint_at(s: string, index: int): int {
    let offset: int = codepoint_byte_offset(s, index);
    if offset < 0 then { return (0 - 1); }
    return utf8_decode_at(s, offset);
  }

  func self_test(): int {
    let ascii: string = "Basalt";
    if utf8_validate(ascii) == false then { return 0; }
    if byte_len(ascii) != 5 then { return 0; }
    if byte_at(ascii, 0) != 80 then { return 0; }
    if codepoint_len(ascii) != 5 then { return 0; }
    if codepoint_at(ascii, 1) != 121 then { return 0; }
    if utf8_validate("é") == false then { return 0; }
    if codepoint_len("é") != 1 then { return 0; }
    if codepoint_at("é", 0) != 233 then { return 0; }
    if codepoint_at(ascii, 99) != (0 - 1) then { return 0; }
    return 1;
  }
}
