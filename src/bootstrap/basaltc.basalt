// Basalt bootstrap v1/v2 driver: AST payload -> C-token IR -> deterministic second pass.
//
// Basalt has no records or dynamic allocation yet, so the AST is an arena of
// parallel fixed-size arrays. Every node carries a kind, up to three child
// links, one integer payload, one auxiliary payload, and a linked-list next
// link. Names and strings are represented by stable payload IDs; the future
// character/string runtime can resolve those IDs without changing the AST.

let N_NONE: int = 0;
let N_INT: int = 1;
let N_BOOL: int = 2;
let N_STRING: int = 3;
let N_VAR: int = 4;
let N_BINOP: int = 5;
let N_CALL: int = 6;
let N_INDIRECT_CALL: int = 37;
let N_DEREF: int = 7;
let N_INDEX: int = 8;
let N_ADDRESS: int = 9;
let N_LET: int = 10;
let N_ASSIGN: int = 11;
let N_PRINT: int = 12;
let N_IF: int = 13;
let N_WHILE: int = 14;
let N_BLOCK: int = 15;
let N_RETURN: int = 16;
let N_GLOBAL: int = 17;
let N_PARAM: int = 18;
let N_FUNC: int = 19;
let N_PROGRAM: int = 20;
let N_LIST: int = 21;
let N_EXPR: int = 22;
let N_BREAK: int = 23;
let N_CONTINUE: int = 24;
let N_FOR: int = 25;
let N_STRUCT: int = 26;
let N_ENUM: int = 27;
let N_FIELD: int = 28;
let N_FIELD_ACCESS: int = 29;
let N_CHAR: int = 30;
let N_NULL: int = 31;
let N_CONST: int = 32;
let N_FLOAT: int = 33;
let N_EXTERN: int = 34;
let N_GENERIC_STRUCT: int = 35;
let N_GENERIC_FUNC: int = 36;

let OP_ADD: int = 1;
let OP_SUB: int = 2;
let OP_MUL: int = 3;
let OP_DIV: int = 4;
let OP_EQ: int = 5;
let OP_NEQ: int = 6;
let OP_LT: int = 7;
let OP_GT: int = 8;
let OP_AND: int = 9;
let OP_OR: int = 10;
let OP_CONCAT: int = 11;
let OP_BITAND: int = 12;
let OP_BITOR: int = 13;
let OP_BITXOR: int = 14;
let OP_SHL: int = 15;
let OP_SHR: int = 16;
let OP_MOD: int = 17;

let TY_INT: int = 1;
let TY_BOOL: int = 2;
let TY_STRING: int = 3;
let TY_VOID: int = 4;
let TY_PTR: int = 5;
let TY_ARRAY: int = 6;
let TY_NAMED: int = 7;
let TY_CHAR: int = 8;
let TY_FLOAT: int = 9;
let TY_DOUBLE: int = 10;
let TY_FUN: int = 11;
let TY_DYN_ARRAY: int = 13;
let TY_PARAM: int = 14;
let TY_GENERIC: int = 15;

let node_kind: int* = 0;
let node_a: int* = 0;
let node_b: int* = 0;
let node_c: int* = 0;
let node_next: int* = 0;
let node_value: int* = 0;
let node_aux: int* = 0;
let node_pos: int* = 0;
let node_scope: int* = 0;
let node_count: int = 1;
let ast_namespace_scope: int = 0;


let node_cap: int = 0;
let payload_cap: int = 0;
let current_source_pos: int = 0;
let code_cap: int = 0;
let pipeline_root: int = 0;
let input_cap: int = 0;
let source_cap: int = 0;
let c_source_cap: int = 0;
let sym_cap: int = 0;

func next_capacity(old: int, need: int): int {
  let n: int = old;
  if n < 16 then n = 16;
  while n < (need + 1) { n = n * 2; }
  return n;
}

func ensure_node(need: int): void {
  if need < node_cap then return;
  let n: int = next_capacity(node_cap, need);
  node_kind = grow_ints(node_kind, node_cap, n);
  node_a = grow_ints(node_a, node_cap, n);
  node_b = grow_ints(node_b, node_cap, n);
  node_c = grow_ints(node_c, node_cap, n);
  node_next = grow_ints(node_next, node_cap, n);
  node_value = grow_ints(node_value, node_cap, n);
  node_aux = grow_ints(node_aux, node_cap, n);
  node_pos = grow_ints(node_pos, node_cap, n);
  node_scope = grow_ints(node_scope, node_cap, n);
  node_cap = n;
}

func ensure_payload(need: int): void {
  if need < payload_cap then return;
  let n: int = next_capacity(payload_cap, need);
  payload_int = grow_ints(payload_int, payload_cap, n);
  payload_name = grow_ints(payload_name, payload_cap, n);
  payload_string = grow_ints(payload_string, payload_cap, n);
  payload_cap = n;
}

func ensure_code(need: int): void {
  if need < code_cap then return;
  let n: int = next_capacity(code_cap, need);
  code_kind = grow_ints(code_kind, code_cap, n);
  code_value = grow_ints(code_value, code_cap, n);
  code_cap = n;
}

func ensure_input(need: int): void {
  if need < input_cap then return;
  let n: int = next_capacity(input_cap, need);
  input_kind = grow_ints(input_kind, input_cap, n);
  input_value = grow_ints(input_value, input_cap, n);
  input_cap = n;
}

func ensure_source(need: int): void {
  if need < source_cap then return;
  let n: int = next_capacity(source_cap, need);
  source = grow_ints(source, source_cap, n);
  source_cap = n;
}

func ensure_sym(need: int): void {
  if need < sym_cap then return;
  let n: int = next_capacity(sym_cap, need);
  sym_start = grow_ints(sym_start, sym_cap, n);
  sym_len = grow_ints(sym_len, sym_cap, n);
  sym_hash = grow_ints(sym_hash, sym_cap, n);
  sym_kind = grow_ints(sym_kind, sym_cap, n);
  sym_type = grow_ints(sym_type, sym_cap, n);
  sym_elem_kind = grow_ints(sym_elem_kind, sym_cap, n);
  sym_elem_name = grow_ints(sym_elem_name, sym_cap, n);
  sym_scope = grow_ints(sym_scope, sym_cap, n);
  sym_cap = n;
}

func ast_node(kind: int, a: int, b: int, c: int, value: int, aux: int): int {
  let id: int = node_count;
  ensure_node(id);
  node_kind[id] = kind;
  node_a[id] = a;
  node_b[id] = b;
  node_c[id] = c;
  node_next[id] = 0;
  node_value[id] = value;
  node_aux[id] = aux;
  node_pos[id] = current_source_pos;
  node_scope[id] = ast_namespace_scope;
  node_count = node_count + 1;
  return id;
}

func ast_link(head: int, item: int): int {
  if head == 0 then return item;
  let p: int = head;
  while p != 0 {
    if p == item then {
      let copy: int = ast_node(node_kind[item], node_a[item], node_b[item], node_c[item], node_value[item], node_aux[item]);
      node_pos[copy] = node_pos[item];
      node_scope[copy] = node_scope[item];
      item = copy;
      break;
    }
    p = node_next[p];
  }
  p = head;
  while node_next[p] != 0 {
    p = node_next[p];
  }
  node_next[p] = item;
  return head;
}

// Payload IDs are deliberately independent from node IDs. The lexer/parser
// stores an identifier table index or string table index in node_value.
let payload_int: int* = 0;
let payload_name: int* = 0;
let payload_string: int* = 0;
let payload_count: int = 1;

func payload_make_int(value: int): int {
  let id: int = payload_count;
  ensure_payload(id);
  payload_int[id] = value;
  payload_count = payload_count + 1;
  return id;
}

func payload_make_name(name_id: int): int {
  let id: int = payload_count;
  ensure_payload(id);
  payload_name[id] = name_id;
  payload_count = payload_count + 1;
  return id;
}

func payload_make_string(string_id: int): int {
  let id: int = payload_count;
  ensure_payload(id);
  payload_string[id] = string_id;
  payload_count = payload_count + 1;
  return id;
}

// C-token IR. This is the stable boundary between AST traversal and the
// eventual text/file runtime. An emitter consumer can serialize these tokens
// to C without changing the AST or generator.
let C_KW: int = 1;
let C_IDENT: int = 2;
let C_INT: int = 3;
let C_STRING: int = 4;
let C_OP: int = 5;
let C_PUNCT: int = 6;
let C_NEWLINE: int = 7;
let code_kind: int* = 0;
let code_value: int* = 0;
let code_count: int = 0;
let emit_for_step: int = 0;
let gen_bind_name: int* = 0;
let gen_bind_type: int* = 0;
let gen_bind_count: int = 0;
let gen_bind_cap: int = 0;
let gen_active_function: int = 0;
let gen_mangle_start: int = 0;
let gen_mangle_len: int = 0;

func gen_bind_clear(): void { gen_bind_count = 0; }
func ensure_gen_bind(need: int): void {
  if need < gen_bind_cap then return;
  let n: int = next_capacity(gen_bind_cap, need);
  gen_bind_name = grow_ints(gen_bind_name, gen_bind_cap, n);
  gen_bind_type = grow_ints(gen_bind_type, gen_bind_cap, n);
  gen_bind_cap = n;
}
func gen_bind_find(name: int): int {
  let i: int = 0;
  while i < gen_bind_count { if gen_bind_name[i] == name then return gen_bind_type[i]; i = i + 1; }
  return 0;
}
func gen_bind_add(name: int, ty: int): void {
  let i: int = 0;
  while i < gen_bind_count { if gen_bind_name[i] == name then { gen_bind_type[i] = ty; return; } i = i + 1; }
  ensure_gen_bind(gen_bind_count); gen_bind_name[gen_bind_count] = name; gen_bind_type[gen_bind_count] = ty; gen_bind_count = gen_bind_count + 1;
}
func gen_append_char(c: int): void { let pos: int = source_len + sym_text_len + gen_mangle_len; ensure_source(pos); source[pos] = c; gen_mangle_len = gen_mangle_len + 1; }
func gen_append_char_text(c: char): void { let pos: int = source_len + sym_text_len + gen_mangle_len; ensure_source(pos); source[pos] = c; gen_mangle_len = gen_mangle_len + 1; }
func gen_append_text(text: string): void { let i: int = 0; while text[i] != '\0' { gen_append_char_text(text[i]); i = i + 1; } }
func gen_append_symbol(id: int): void { let i: int = 0; while i < sym_len[id] { gen_append_char(source[sym_start[id] + i]); i = i + 1; } }
func gen_append_c_symbol(id: int): void {
  let i: int = 0;
  while i < sym_len[id] {
    let c: int = source[sym_start[id] + i];
    if c == 58 && i + 1 < sym_len[id] && source[sym_start[id] + i + 1] == 58 then { gen_append_char(95); gen_append_char(95); i = i + 2; }
    else { gen_append_char(c); i = i + 1; }
  }
}
func gen_mangle_intern(kind: int): int {
  let h: int = span_hash(gen_mangle_start, gen_mangle_len);
  let old: int = sym_lookup(gen_mangle_start, gen_mangle_len, h);
  if old != 0 then return old;
  let id: int = sym_intern(gen_mangle_start, gen_mangle_len, kind, 0);
  sym_text_len = sym_text_len + gen_mangle_len;
  return id;
}
func sym_c_symbol(id: int): int {
  gen_mangle_start = source_len + sym_text_len; gen_mangle_len = 0; gen_append_c_symbol(id);
  return gen_mangle_intern(L_ID);
}
func gen_mangle_type(ty: int): void {
  if ty == 0 then { gen_append_text("void"); return; }
  if node_kind[ty] == TY_PARAM then { let b: int = gen_bind_find(node_value[ty]); if b != 0 then { gen_mangle_type(b); return; } gen_append_c_symbol(node_value[ty]); return; }
  if node_kind[ty] == TY_INT then gen_append_text("int");
  else if node_kind[ty] == TY_BOOL then gen_append_text("bool");
  else if node_kind[ty] == TY_STRING then gen_append_text("char_ptr");
  else if node_kind[ty] == TY_CHAR then gen_append_text("char");
  else if node_kind[ty] == TY_FLOAT then gen_append_text("float");
  else if node_kind[ty] == TY_DOUBLE then gen_append_text("double");
  else if node_kind[ty] == TY_VOID then gen_append_text("void");
  else if node_kind[ty] == TY_NAMED then gen_append_c_symbol(node_value[ty]);
  else if node_kind[ty] == TY_PTR then { gen_append_text("ptr_"); gen_mangle_type(node_a[ty]); }
  else if node_kind[ty] == TY_ARRAY || node_kind[ty] == TY_DYN_ARRAY then { gen_append_text("array_"); gen_mangle_type(node_a[ty]); }
  else if node_kind[ty] == TY_GENERIC then {
    gen_append_c_symbol(node_value[ty]); gen_append_text("__");
    let a: int = node_a[ty];
    while a != 0 { gen_mangle_type(a); if node_next[a] != 0 then gen_append_text("__"); a = node_next[a]; }
  } else gen_append_text("int");
}
func gen_mangled_type_symbol(ty: int): int {
  gen_mangle_start = source_len + sym_text_len; gen_mangle_len = 0; gen_mangle_type(ty);
  return gen_mangle_intern(0);
}
func gen_mangled_function_symbol(base: int, args: int): int {
  gen_mangle_start = source_len + sym_text_len; gen_mangle_len = 0; gen_append_c_symbol(base); gen_append_text("__");
  let a: int = args; while a != 0 { gen_mangle_type(a); if node_next[a] != 0 then gen_append_text("__"); a = node_next[a]; }
  return gen_mangle_intern(0);
}

func code_emit(kind: int, value: int): void {
  ensure_code(code_count);
  code_kind[code_count] = kind;
  code_value[code_count] = value;
  code_count = code_count + 1;
}

func code_reset(): void {
  code_count = 0;
}

let gen_spec_kind: int* = 0;
let gen_spec_decl: int* = 0;
let gen_spec_type: int* = 0;
let gen_spec_name: int* = 0;
let gen_spec_count: int = 0;
let gen_spec_cap: int = 0;
let gen_name_override: int = 0;
let gen_debug: int = 0;

func ensure_gen_specs(need: int): void {
  if need < gen_spec_cap then return;
  let n: int = next_capacity(gen_spec_cap, need);
  gen_spec_kind = grow_ints(gen_spec_kind, gen_spec_cap, n);
  gen_spec_decl = grow_ints(gen_spec_decl, gen_spec_cap, n);
  gen_spec_type = grow_ints(gen_spec_type, gen_spec_cap, n);
  gen_spec_name = grow_ints(gen_spec_name, gen_spec_cap, n);
  gen_spec_cap = n;
}
func gen_substitute_type(ty: int): int {
  if ty == 0 then return 0;
  if node_kind[ty] == TY_PARAM then { let b: int = gen_bind_find(node_value[ty]); if b != 0 then return gen_substitute_type(b); return ast_node(TY_PARAM, node_a[ty], node_b[ty], node_c[ty], node_value[ty], node_aux[ty]); }
  if node_kind[ty] == TY_PTR then return ast_node(TY_PTR, gen_substitute_type(node_a[ty]), 0, 0, 0, 0);
  if node_kind[ty] == TY_ARRAY then return ast_node(TY_ARRAY, gen_substitute_type(node_a[ty]), 0, 0, node_value[ty], 0);
  if node_kind[ty] == TY_DYN_ARRAY then return ast_node(TY_DYN_ARRAY, gen_substitute_type(node_a[ty]), 0, 0, 0, 0);
  if node_kind[ty] == TY_GENERIC then {
    let args: int = 0; let p: int = node_a[ty];
    while p != 0 { let q: int = gen_substitute_type(p); if args == 0 then args = q; else args = ast_link(args, q); p = node_next[p]; }
    return ast_node(TY_GENERIC, args, 0, 0, node_value[ty], 0);
  }
  return ast_node(node_kind[ty], node_a[ty], node_b[ty], node_c[ty], node_value[ty], node_aux[ty]);
}
func gen_active_param_type(name: int): int {
  if gen_active_function == 0 then return 0;
  let p: int = node_c[gen_active_function];
  while p != 0 {
    if node_a[p] == name then return node_b[p];
    p = node_next[p];
  }
  return 0;
}

func gen_spec_exists(kind: int, decl: int, name: int): int {
  let i: int = 0;
  while i < gen_spec_count { if gen_spec_kind[i] == kind && gen_spec_decl[i] == decl && gen_spec_name[i] == name then return 1; i = i + 1; }
  return 0;
}
func gen_add_struct_spec(ty: int): void {
  let q: int = gen_substitute_type(ty);
  if q == 0 || node_kind[q] != TY_GENERIC then return;
  let decl: int = tc_find_struct(node_value[q]); if decl == 0 then return;
  let name: int = gen_mangled_type_symbol(q);
  if gen_spec_exists(1, decl, name) == 1 then return;
  ensure_gen_specs(gen_spec_count); gen_spec_kind[gen_spec_count] = 1; gen_spec_decl[gen_spec_count] = decl; gen_spec_type[gen_spec_count] = q; gen_spec_name[gen_spec_count] = name; gen_spec_count = gen_spec_count + 1;
  let a: int = node_a[q]; while a != 0 { gen_collect_type(a); a = node_next[a]; }
}
func gen_type_has_param(ty: int): int {
  if ty == 0 then return 0;
  if node_kind[ty] == TY_PARAM then return 1;
  if node_kind[ty] == TY_PTR || node_kind[ty] == TY_ARRAY || node_kind[ty] == TY_DYN_ARRAY then return gen_type_has_param(node_a[ty]);
  if node_kind[ty] == TY_GENERIC then {
    let a: int = node_a[ty];
    while a != 0 { if gen_type_has_param(a) == 1 then return 1; a = node_next[a]; }
  }
  return 0;
}

func gen_add_fun_spec(decl: int, args: int): void {
  let saved_count: int = gen_bind_count;
  ensure_gen_bind(saved_count + saved_count);
  let save_i: int = 0;
  while save_i < saved_count {
    gen_bind_name[saved_count + save_i] = gen_bind_name[save_i];
    gen_bind_type[saved_count + save_i] = gen_bind_type[save_i];
    save_i = save_i + 1;
  }
  let actual: int = 0; let p: int = args;
  while p != 0 { let q: int = gen_substitute_type(p); if actual == 0 then actual = q; else actual = ast_link(actual, q); p = node_next[p]; }
  gen_bind_decl(decl, actual);
  let typeargs: int = 0; let tp: int = node_aux[decl];
  while tp != 0 {
    let bt: int = gen_bind_find(node_a[tp]);
    if bt == 0 then bt = ast_node(TY_PARAM, 0, 0, 0, node_a[tp], 0);
    let cq: int = gen_substitute_type(bt);
    if typeargs == 0 then typeargs = cq; else typeargs = ast_link(typeargs, cq);
    tp = node_next[tp];
  }
  gen_bind_clear();
  let restore_i: int = 0;
  while restore_i < saved_count {
    gen_bind_name[restore_i] = gen_bind_name[saved_count + restore_i];
    gen_bind_type[restore_i] = gen_bind_type[saved_count + restore_i];
    restore_i = restore_i + 1;
  }
  gen_bind_count = saved_count;
  let name: int = gen_mangled_function_symbol(node_value[decl], typeargs);
  if gen_spec_exists(2, decl, name) == 1 then return;
  ensure_gen_specs(gen_spec_count); gen_spec_kind[gen_spec_count] = 2; gen_spec_decl[gen_spec_count] = decl; gen_spec_type[gen_spec_count] = actual; gen_spec_name[gen_spec_count] = name; gen_spec_count = gen_spec_count + 1;
  let a: int = actual; while a != 0 { gen_collect_type(a); a = node_next[a]; }
}
func gen_collect_type(ty: int): void {
  if ty == 0 then { return; }
  if node_kind[ty] == TY_GENERIC then { gen_add_struct_spec(ty); }
  else if (node_kind[ty] == TY_PTR || node_kind[ty] == TY_ARRAY || node_kind[ty] == TY_DYN_ARRAY) then { gen_collect_type(node_a[ty]); }
}
func gen_collect_expr(id: int): void {
  if id == 0 then return;
  let k: int = node_kind[id];
  if k == N_CALL then {
    let f: int = tc_find_function_ctx(node_value[id], node_scope[id]);
    if f != 0 && node_kind[f] == N_GENERIC_FUNC then {
      let aa: int = node_a[id]; let actual: int = 0;
      while aa != 0 { let q: int = tc_emit_arg_type(aa); if q == 0 then { tc_expr(aa); q = tc_result_type; if q == 0 then q = tc_type_node_from_summary(tc_kind, tc_name, tc_elem_kind, tc_elem_name); } if q != 0 then q = gen_substitute_type(q); if actual == 0 then actual = q; else actual = ast_link(actual, q); gen_collect_type(q); aa = node_next[aa]; }
      let unresolved: int = 0;
      let check_actual: int = actual;
      while check_actual != 0 { if gen_type_has_param(check_actual) == 1 then unresolved = 1; check_actual = node_next[check_actual]; }
      if unresolved == 0 then gen_add_fun_spec(f, actual);
    } else { let aa: int = node_a[id]; while aa != 0 { gen_collect_expr(aa); aa = node_next[aa]; } }
    return;
  }
  if k == N_INDIRECT_CALL then { gen_collect_expr(node_a[id]); let aa: int = node_b[id]; while aa != 0 { gen_collect_expr(aa); aa = node_next[aa]; } return; }
  if k == N_BINOP then { gen_collect_expr(node_a[id]); gen_collect_expr(node_b[id]); return; }
  if k == N_FIELD_ACCESS || k == N_INDEX || k == N_DEREF || k == N_ADDRESS then { gen_collect_expr(node_a[id]); gen_collect_expr(node_b[id]); return; }
}
func gen_collect_stmt(id: int): void {
  if id == 0 then return;
  let k: int = node_kind[id];
  if k == N_LET || k == N_CONST then { gen_collect_type(node_b[id]); gen_collect_expr(node_c[id]); return; }
  if k == N_GLOBAL then { gen_collect_type(node_b[id]); gen_collect_expr(node_c[id]); return; }
  if k == N_ASSIGN then { gen_collect_expr(node_a[id]); gen_collect_expr(node_b[id]); return; }
  if k == N_PRINT || k == N_EXPR || k == N_RETURN then { gen_collect_expr(node_a[id]); return; }
  if k == N_BLOCK then { let x: int = node_a[id]; while x != 0 { gen_collect_stmt(x); x = node_next[x]; } return; }
  if k == N_IF then { gen_collect_expr(node_a[id]); gen_collect_stmt(node_b[id]); gen_collect_stmt(node_c[id]); return; }
  if k == N_WHILE then { gen_collect_expr(node_a[id]); gen_collect_stmt(node_b[id]); return; }
  if k == N_FOR then { gen_collect_stmt(node_a[id]); gen_collect_expr(node_b[id]); gen_collect_stmt(node_c[id]); gen_collect_stmt(node_value[id]); return; }
}
func gen_type(kind: int, child: int, size: int): void {
  if kind == TY_INT then code_emit(C_KW, 1);
  else if kind == TY_BOOL then code_emit(C_KW, 2);
  else if kind == TY_STRING then code_emit(C_KW, 3);
  else if kind == TY_CHAR then code_emit(C_KW, 17);
  else if kind == TY_FLOAT then code_emit(C_KW, 18);
  else if kind == TY_DOUBLE then code_emit(C_KW, 15);
  else if kind == TY_VOID then code_emit(C_KW, 4);
  else if kind == TY_PTR then {
    gen_type(node_kind[node_a[child]], node_a[child], 0);
    code_emit(C_PUNCT, 1);
  } else if kind == TY_ARRAY then {
    gen_type(node_kind[child], node_a[child], node_value[child]);
    code_emit(C_PUNCT, 2);
    code_emit(C_INT, size);
    code_emit(C_PUNCT, 3);
  } else if kind == TY_DYN_ARRAY then {
    code_emit(C_IDENT, 1003);
    code_emit(C_PUNCT, 18);
  } else if kind == TY_NAMED then {
    code_emit(C_IDENT, sym_c_symbol(node_value[child]));
    code_emit(C_PUNCT, 18);
  } else if kind == TY_GENERIC then {
    code_emit(C_IDENT, gen_mangled_type_symbol(child));
    code_emit(C_PUNCT, 18);
  } else if kind == TY_PARAM then {
    let b: int = gen_bind_find(node_value[child]);
    if b != 0 then gen_type(node_kind[b], b, node_value[b]);
    else code_emit(C_IDENT, sym_c_symbol(node_value[child]));
    code_emit(C_PUNCT, 18);
  }
}

func gen_scalar_kind(arg: int): int {
  if arg != 0 then {
    let typed: int = tc_emit_arg_type(arg);
    if typed != 0 then {
      let resolved: int = gen_substitute_type(typed);
      if resolved != 0 && node_kind[resolved] != TY_PARAM then return node_kind[resolved];
    }
    if node_kind[arg] == N_INT then return TY_INT;
    if node_kind[arg] == N_BOOL then return TY_BOOL;
    if node_kind[arg] == N_CHAR then return TY_CHAR;
    if node_kind[arg] == N_FLOAT then return TY_DOUBLE;
    if node_kind[arg] == N_STRING then return TY_STRING;
    if node_kind[arg] == N_VAR then return sym_type[node_value[arg]];
  }
  return gen_expr_kind(arg);
}

func gen_scalar_name(arg: int): int {
  if arg != 0 then {
    let typed: int = tc_emit_arg_type(arg);
    if typed != 0 then {
      let resolved: int = gen_substitute_type(typed);
      if resolved != 0 && node_kind[resolved] == TY_NAMED then return node_value[resolved];
    }
    if node_kind[arg] == N_VAR then return sym_elem_name[node_value[arg]];
  }
  return 0;
}

func gen_array_elem_kind(arg: int): int {
  if arg != 0 && node_kind[arg] == N_VAR then {
    let name: int = node_value[arg];
    let formal_type: int = gen_active_param_type(name);
    if formal_type != 0 then {
      let resolved_type: int = gen_substitute_type(formal_type);
      if resolved_type != 0 && node_kind[resolved_type] == TY_DYN_ARRAY && node_a[resolved_type] != 0 then return node_kind[node_a[resolved_type]];
    }
    let kind: int = sym_elem_kind[name];
    let elem_name: int = sym_elem_name[name];
    let param_name: int = elem_name;
    if kind == TY_PARAM && elem_name != 0 && node_kind[elem_name] == TY_PARAM then param_name = node_value[elem_name];
    if kind == TY_PARAM then {
      let bound: int = gen_bind_find(param_name);
      if bound != 0 then {
        let resolved: int = gen_substitute_type(bound);
        if resolved != 0 then return node_kind[resolved];
      }
    }
    return kind;
  }
  return TY_INT;
}

func gen_array_elem_name(arg: int): int {
  if arg != 0 && node_kind[arg] == N_VAR then {
    let name: int = node_value[arg];
    let formal_type: int = gen_active_param_type(name);
    if formal_type != 0 then {
      let resolved_type: int = gen_substitute_type(formal_type);
      if resolved_type != 0 && node_kind[resolved_type] == TY_DYN_ARRAY && node_a[resolved_type] != 0 && node_kind[node_a[resolved_type]] == TY_NAMED then return node_value[node_a[resolved_type]];
    }
    let kind: int = sym_elem_kind[name];
    let elem_name: int = sym_elem_name[name];
    let param_name: int = elem_name;
    if kind == TY_PARAM && elem_name != 0 && node_kind[elem_name] == TY_PARAM then param_name = node_value[elem_name];
    if kind == TY_PARAM then {
      let bound: int = gen_bind_find(param_name);
      if bound != 0 then {
        let resolved: int = gen_substitute_type(bound);
        if resolved != 0 && node_kind[resolved] == TY_NAMED then return node_value[resolved];
      }
      return 0;
    }
    return elem_name;
  }
  return 0;
}

func gen_array_elem_type(kind: int, name: int): void {
  if kind == TY_INT then code_emit(C_KW, 1);
  else if kind == TY_BOOL then code_emit(C_KW, 2);
  else if kind == TY_CHAR then code_emit(C_KW, 17);
  else if kind == TY_FLOAT then code_emit(C_KW, 18);
  else if kind == TY_DOUBLE then code_emit(C_KW, 15);
  else if kind == TY_STRING then { code_emit(C_KW, 17); code_emit(C_PUNCT, 1); }
  else if kind == TY_NAMED then code_emit(C_IDENT, sym_c_symbol(name));
  else if kind == TY_PTR then { code_emit(C_KW, 1); code_emit(C_PUNCT, 1); }
  else code_emit(C_KW, 1);
}

func gen_array_sizeof(kind: int, name: int): void {
  code_emit(C_IDENT, 1011);
  code_emit(C_PUNCT, 4);
  gen_array_elem_type(kind, name);
  code_emit(C_PUNCT, 5);
}

func gen_array_value_ptr(kind: int, name: int, value: int): void {
  code_emit(C_PUNCT, 10);
  code_emit(C_PUNCT, 4);
  gen_array_elem_type(kind, name);
  if kind == TY_NAMED then {
    code_emit(C_PUNCT, 2);
    code_emit(C_PUNCT, 3);
  }
  code_emit(C_PUNCT, 5);
  code_emit(C_PUNCT, 24);
  if kind == TY_FLOAT then {
    code_emit(C_PUNCT, 4);
    code_emit(C_KW, 18);
    code_emit(C_PUNCT, 5);
  }
  gen_expr(value);
  code_emit(C_PUNCT, 25);
}

func gen_memory_sizeof(arg: int): void {
  let ty: int = tc_emit_arg_type(arg);
  if ty != 0 then ty = gen_substitute_type(ty);
  if ty != 0 && node_kind[ty] == TY_PTR && node_a[ty] != 0 then {
    let elem: int = gen_substitute_type(node_a[ty]);
    gen_array_sizeof(node_kind[elem], node_value[elem]);
  } else if ty != 0 then gen_array_sizeof(node_kind[ty], node_value[ty]);
  else gen_array_sizeof(TY_INT, 0);
}

func gen_memory_builtin(id: int): void {
  let call_name: int = node_value[id];
  let call_len: int = sym_len[call_name];
  let call_hash: int = sym_hash[call_name];
  let a: int = node_a[id];
  if call_len == 12 && call_hash == 334590 then {
    let witness: int = node_next[a];
    let elem_kind: int = gen_scalar_kind(witness);
    let elem_name: int = gen_scalar_name(witness);
    code_emit(C_PUNCT, 6);
    code_emit(C_PUNCT, 6);
    code_emit(C_KW, 4);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 6);
    gen_expr(witness);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 7);
    code_emit(C_PUNCT, 6);
    gen_array_elem_type(elem_kind, elem_name);
    code_emit(C_PUNCT, 1);
    code_emit(C_PUNCT, 8);
    code_emit(C_IDENT, 1016);
    code_emit(C_PUNCT, 6);
    gen_expr(a);
    code_emit(C_PUNCT, 7);
    gen_array_sizeof(elem_kind, elem_name);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 8);
  } else if call_len == 13 && call_hash == 806795 then {
    let old_count: int = node_next[a];
    let new_count: int = node_next[old_count];
    let zero: int = node_next[new_count];
    let ptr_ty: int = tc_emit_arg_type(a);
    if ptr_ty != 0 then ptr_ty = gen_substitute_type(ptr_ty);
    if ptr_ty == 0 then ptr_ty = ast_node(TY_PTR, ast_node(TY_INT, 0, 0, 0, 0, 0), 0, 0, 0, 0);
    code_emit(C_PUNCT, 6);
    code_emit(C_PUNCT, 6);
    code_emit(C_KW, 4);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 6);
    gen_expr(zero);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 7);
    code_emit(C_PUNCT, 6);
    gen_type(node_kind[ptr_ty], ptr_ty, 0);
    code_emit(C_PUNCT, 8);
    code_emit(C_IDENT, 1017);
    code_emit(C_PUNCT, 6);
    code_emit(C_PUNCT, 6);
    code_emit(C_KW, 4);
    code_emit(C_PUNCT, 1);
    code_emit(C_PUNCT, 8);
    gen_expr(a);
    code_emit(C_PUNCT, 7);
    gen_expr(old_count);
    code_emit(C_PUNCT, 7);
    gen_expr(new_count);
    code_emit(C_PUNCT, 7);
    gen_memory_sizeof(a);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 8);
  } else if call_len == 11 && call_hash == 649155 then {
    code_emit(C_IDENT, 1018);
    code_emit(C_PUNCT, 6);
    code_emit(C_PUNCT, 6);
    code_emit(C_KW, 4);
    code_emit(C_PUNCT, 1);
    code_emit(C_PUNCT, 8);
    gen_expr(a);
    code_emit(C_PUNCT, 8);
  } else {
    code_emit(C_IDENT, sym_c_symbol(call_name));
    code_emit(C_PUNCT, 6);
    let arg: int = a;
    while arg != 0 { gen_expr(arg); if node_next[arg] != 0 then code_emit(C_PUNCT, 7); arg = node_next[arg]; }
    code_emit(C_PUNCT, 8);
  }
}

func gen_call_name(id: int): int {
  let f: int = tc_find_function_ctx(node_value[id], node_scope[id]);
  if f == 0 then return sym_c_symbol(node_value[id]);
  if node_kind[f] != N_GENERIC_FUNC then return sym_c_symbol(node_value[f]);
  let actual: int = 0; let a: int = node_a[id];
  while a != 0 {
    let q: int = 0;
      q = tc_emit_arg_type(a);
    if q == 0 then { tc_expr(a); q = tc_result_type; if q == 0 then q = tc_type_node_from_summary(tc_kind, tc_name, tc_elem_kind, tc_elem_name); }
    if q != 0 then q = gen_substitute_type(q);
    if actual == 0 then actual = q; else actual = ast_link(actual, q);
    a = node_next[a];
  }
  let saved_count: int = gen_bind_count;
  ensure_gen_bind(saved_count + saved_count);
  let save_i: int = 0;
  while save_i < saved_count {
    gen_bind_name[saved_count + save_i] = gen_bind_name[save_i];
    gen_bind_type[saved_count + save_i] = gen_bind_type[save_i];
    save_i = save_i + 1;
  }
  gen_bind_decl(f, actual);
  let typeargs: int = 0; let tp: int = node_aux[f];
  while tp != 0 {
    let bt: int = gen_bind_find(node_a[tp]);
    if bt == 0 then bt = ast_node(TY_PARAM, 0, 0, 0, node_a[tp], 0);
    let cq: int = gen_substitute_type(bt);
    if typeargs == 0 then typeargs = cq; else typeargs = ast_link(typeargs, cq);
    tp = node_next[tp];
  }
  gen_bind_clear();
  let restore_i: int = 0;
  while restore_i < saved_count {
    gen_bind_name[restore_i] = gen_bind_name[saved_count + restore_i];
    gen_bind_type[restore_i] = gen_bind_type[saved_count + restore_i];
    restore_i = restore_i + 1;
  }
  gen_bind_count = saved_count;
  return gen_mangled_function_symbol(node_value[f], typeargs);
}

func gen_expr(id: int): void {
  let k: int = node_kind[id];
  if k == N_INT then code_emit(C_INT, node_value[id]);
  else if k == N_BOOL then code_emit(C_INT, node_value[id]);
  else if k == N_FLOAT then code_emit(C_IDENT, node_value[id]);
  else if k == N_STRING then code_emit(C_STRING, node_value[id]);
  else if k == N_CHAR then code_emit(C_INT, node_value[id]);
  else if k == N_NULL then { code_emit(C_INT, 0); }
  else if k == N_VAR then code_emit(C_IDENT, sym_c_symbol(node_value[id]));
  else if k == N_BINOP then {
    if node_value[id] == OP_CONCAT then { code_emit(C_IDENT, 1002); code_emit(C_PUNCT, 6); gen_expr(node_a[id]); code_emit(C_PUNCT, 7); gen_expr(node_b[id]); code_emit(C_PUNCT, 8); }
    else if node_value[id] == OP_SUB && gen_expr_kind(node_a[id]) == TY_PTR && gen_expr_kind(node_b[id]) == TY_PTR then { code_emit(C_PUNCT, 4); code_emit(C_KW, 1); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 4); gen_expr(node_a[id]); code_emit(C_OP, node_value[id]); gen_expr(node_b[id]); code_emit(C_PUNCT, 5); }
    else { code_emit(C_PUNCT, 4); gen_expr(node_a[id]); code_emit(C_OP, node_value[id]); gen_expr(node_b[id]); code_emit(C_PUNCT, 5); }
  } else if k == N_CALL then {
    let call_name: int = node_value[id];
    let call_len: int = sym_len[call_name];
    let call_hash: int = sym_hash[call_name];
    if (call_len == 12 && call_hash == 334590) || (call_len == 13 && call_hash == 806795) || (call_len == 11 && call_hash == 649155) then gen_memory_builtin(id);
    else { code_emit(C_IDENT, gen_call_name(id)); code_emit(C_PUNCT, 6); let arg: int = node_a[id]; while arg != 0 { gen_expr(arg); if node_next[arg] != 0 then code_emit(C_PUNCT, 7); arg = node_next[arg]; } code_emit(C_PUNCT, 8); }
  } else if k == N_INDIRECT_CALL then {
    code_emit(C_PUNCT, 4); gen_expr(node_a[id]); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 6);
    let arg: int = node_b[id]; while arg != 0 { gen_expr(arg); if node_next[arg] != 0 then code_emit(C_PUNCT, 7); arg = node_next[arg]; }
    code_emit(C_PUNCT, 8);
  } else if k == N_DEREF then { code_emit(C_PUNCT, 9); gen_expr(node_a[id]); }
  else if k == N_ADDRESS then { code_emit(C_PUNCT, 10); gen_expr(node_a[id]); }
  else if k == N_INDEX then {
    gen_expr(node_a[id]); code_emit(C_PUNCT, 2); gen_expr(node_b[id]); code_emit(C_PUNCT, 3);
  }
  else if k == N_FIELD_ACCESS then { gen_expr(node_a[id]); code_emit(C_PUNCT, 17); code_emit(C_IDENT, node_value[id]); }
}

func gen_expr_kind(id: int): int {
  let k: int = node_kind[id];
  if k == N_INT || k == N_BOOL then return TY_INT;
  if k == N_CHAR then return TY_CHAR;
  if k == N_FLOAT then return TY_DOUBLE;
  if k == N_STRING then return TY_STRING;
  if k == N_NULL then return TY_PTR;
  if k == N_VAR then {
    let vt: int = sym_type[node_value[id]];
    if vt > 99 then {
      tc_elem_kind = sym_elem_kind[node_value[id]];
      tc_elem_name = sym_elem_name[node_value[id]];
      return vt - 100;
    }
    return vt;
  }
  if k == N_INDEX then {
    let bt: int = gen_expr_kind(node_a[id]);
    if bt == TY_STRING then return TY_CHAR;
    if bt == TY_PTR then return TY_INT;
    return TY_INT;
  }
  if k == N_DEREF then return TY_INT;
  if k == N_FIELD_ACCESS then return TY_INT;
  if k == N_CALL || k == N_INDIRECT_CALL then return tc_expr_kind_for_emit(id);
  if k == N_BINOP then {
    if node_value[id] == OP_CONCAT then return TY_STRING;
    if node_value[id] == OP_EQ || node_value[id] == OP_NEQ || node_value[id] == OP_LT || node_value[id] == OP_GT || node_value[id] == OP_AND || node_value[id] == OP_OR then return TY_BOOL;
    if node_value[id] == OP_SUB && gen_expr_kind(node_a[id]) == TY_PTR && gen_expr_kind(node_b[id]) == TY_PTR then return TY_INT;
    if node_value[id] == OP_BITAND || node_value[id] == OP_BITOR || node_value[id] == OP_BITXOR || node_value[id] == OP_SHL || node_value[id] == OP_SHR then return TY_INT;
    let ak: int = gen_expr_kind(node_a[id]); let bk: int = gen_expr_kind(node_b[id]);
    if ak == TY_DOUBLE || bk == TY_DOUBLE then return TY_DOUBLE;
    if ak == TY_FLOAT || bk == TY_FLOAT then return TY_FLOAT;
    if ak == TY_PTR then return TY_PTR;
    return TY_INT;
  }
  return TY_INT;
}

func gen_for_clause(id: int): void {
  if id == 0 then return;
  if node_kind[id] == N_LET then {
    gen_type(node_kind[node_b[id]], node_b[id], node_value[node_b[id]]);
    code_emit(C_IDENT, node_a[id]);
    code_emit(C_PUNCT, 11);
    gen_expr(node_c[id]);
  } else if node_kind[id] == N_ASSIGN then {
    gen_expr(node_a[id]);
    code_emit(C_PUNCT, 11);
    gen_expr(node_b[id]);
  } else if node_kind[id] == N_EXPR then gen_expr(node_a[id]);
}

func gen_initializer(ty: int, expr: int): void {
  let st: int = gen_substitute_type(ty);
  if (node_kind[st] == TY_NAMED || node_kind[st] == TY_GENERIC) && node_kind[expr] == N_INT && node_value[expr] == 0 then code_emit(C_PUNCT, 19);
  else gen_expr(expr);
}

func gen_fun_decl(ty: int, name: int): void {
  let ret: int = node_b[ty];
  gen_type(node_kind[ret], ret, node_value[ret]);
  code_emit(C_PUNCT, 4);
  code_emit(C_PUNCT, 9);
  code_emit(C_IDENT, sym_c_symbol(name));
  code_emit(C_PUNCT, 5);
  code_emit(C_PUNCT, 6);
  let p: int = node_a[ty];
  while p != 0 {
    gen_type(node_kind[p], p, node_value[p]);
    if node_next[p] != 0 then code_emit(C_PUNCT, 7);
    p = node_next[p];
  }
  code_emit(C_PUNCT, 8);
}

func gen_decl(ty: int, name: int): void {
  if node_kind[ty] == TY_FUN then gen_fun_decl(ty, name);
  else if node_kind[ty] == TY_ARRAY then {
    let inner: int = node_a[ty];
    gen_type(node_kind[inner], inner, node_value[inner]);
    code_emit(C_IDENT, sym_c_symbol(name)); code_emit(C_PUNCT, 2); code_emit(C_INT, node_value[ty]); code_emit(C_PUNCT, 3);
  } else {
    gen_type(node_kind[ty], ty, node_value[ty]);
    code_emit(C_IDENT, sym_c_symbol(name));
  }
}

func gen_stmt(id: int): void {
  let k: int = node_kind[id];
  if k == N_GLOBAL then {
    gen_decl(node_b[id], node_a[id]);
    code_emit(C_PUNCT, 11);
    gen_initializer(node_b[id], node_c[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_CONST then {
    code_emit(C_KW, 16);
    gen_decl(node_b[id], node_a[id]);
    code_emit(C_PUNCT, 11);
    gen_initializer(node_b[id], node_c[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_LET then {
    gen_decl(node_b[id], node_a[id]);
    code_emit(C_PUNCT, 11);
    gen_initializer(node_b[id], node_c[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_ASSIGN then {
    gen_expr(node_a[id]);
    code_emit(C_PUNCT, 11);
    gen_expr(node_b[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_PRINT then {
    code_emit(C_IDENT, 1001);
    let pk: int = gen_expr_kind(node_a[id]);
    if pk == TY_STRING then code_emit(C_PUNCT, 16);
    else if pk == TY_CHAR then code_emit(C_PUNCT, 20);
    else if pk == TY_FLOAT || pk == TY_DOUBLE then code_emit(C_PUNCT, 21);
    else code_emit(C_PUNCT, 15);
    gen_expr(node_a[id]);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_EXPR then {
    gen_expr(node_a[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_RETURN then {
    code_emit(C_KW, 5);
    if node_a[id] != 0 then gen_expr(node_a[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_BREAK then {
    code_emit(C_KW, 9);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_CONTINUE then {
    if emit_for_step != 0 then gen_stmt(emit_for_step);
    code_emit(C_KW, 10);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_BLOCK then {
    code_emit(C_PUNCT, 13);
    let item: int = node_a[id];
    while item != 0 {
      gen_stmt(item);
      item = node_next[item];
    }
    code_emit(C_PUNCT, 14);
  } else if k == N_IF then {
    code_emit(C_KW, 6);
    code_emit(C_PUNCT, 6);
    gen_expr(node_a[id]);
    code_emit(C_PUNCT, 8);
    gen_stmt(node_b[id]);
    code_emit(C_KW, 7);
    gen_stmt(node_c[id]);
  } else if k == N_FOR then {
    code_emit(C_KW, 11);
    code_emit(C_PUNCT, 4);
    gen_for_clause(node_a[id]);
    code_emit(C_PUNCT, 12);
    gen_expr(node_b[id]);
    code_emit(C_PUNCT, 12);
    gen_for_clause(node_value[id]);
    code_emit(C_PUNCT, 5);
    gen_stmt(node_c[id]);
  } else if k == N_WHILE then {
    code_emit(C_KW, 8);
    code_emit(C_PUNCT, 4);
    gen_expr(node_a[id]);
    code_emit(C_PUNCT, 5);
    let old_step: int = emit_for_step;
    emit_for_step = node_aux[id];
    gen_stmt(node_b[id]);
    emit_for_step = old_step;
  }
}

func gen_unify_formal(formal: int, actual: int): void {
  if formal == 0 || actual == 0 then return;
  if node_kind[formal] == TY_PARAM then {
    if node_kind[actual] == TY_PARAM && node_value[formal] == node_value[actual] then return;
    if gen_bind_find(node_value[formal]) == 0 then gen_bind_add(node_value[formal], actual);
    return;
  }
  if node_kind[formal] == TY_GENERIC && node_kind[actual] == TY_GENERIC then {
    if node_value[formal] != node_value[actual] then return;
    let fp: int = node_a[formal]; let ap: int = node_a[actual];
    while fp != 0 && ap != 0 { gen_unify_formal(fp, ap); fp = node_next[fp]; ap = node_next[ap]; }
    return;
  }
  if node_kind[formal] == TY_PTR && node_kind[actual] == TY_PTR then { gen_unify_formal(node_a[formal], node_a[actual]); return; }
  if node_kind[formal] == TY_ARRAY && node_kind[actual] == TY_ARRAY then { gen_unify_formal(node_a[formal], node_a[actual]); return; }
  if node_kind[formal] == TY_DYN_ARRAY && node_kind[actual] == TY_DYN_ARRAY then { gen_unify_formal(node_a[formal], node_a[actual]); return; }
}

func gen_bind_decl(decl: int, inst: int): void {
  gen_bind_clear();
  if node_kind[decl] == N_GENERIC_FUNC then {
    let p: int = node_c[decl]; let a: int = inst;
    while p != 0 && a != 0 { gen_unify_formal(node_b[p], a); p = node_next[p]; a = node_next[a]; }
    return;
  }
  let p: int = node_c[decl];
  let a: int = node_a[inst];
  while p != 0 && a != 0 { gen_bind_add(node_a[p], a); p = node_next[p]; a = node_next[a]; }
}
func gen_struct_decl_specialized(decl: int, inst: int, cname: int): void {
  gen_bind_decl(decl, inst);
  code_emit(C_KW, 12); code_emit(C_IDENT, cname); code_emit(C_PUNCT, 13);
  let f: int = node_a[decl];
  while f != 0 { let ft: int = gen_substitute_type(node_b[f]); gen_decl(ft, node_a[f]); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0); f = node_next[f]; }
  code_emit(C_PUNCT, 14); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0);
}
func gen_function_specialized(decl: int, inst: int, cname: int): void {
  gen_bind_decl(decl, inst);
  let ret: int = gen_substitute_type(node_b[decl]);
  gen_type(node_kind[ret], ret, node_value[ret]); code_emit(C_IDENT, cname); code_emit(C_PUNCT, 6);
  let p: int = node_c[decl];
  while p != 0 { let pt: int = gen_substitute_type(node_b[p]); gen_decl(pt, node_a[p]); if node_next[p] != 0 then code_emit(C_PUNCT, 7); p = node_next[p]; }
  code_emit(C_PUNCT, 8);
  let old_active_function: int = gen_active_function;
  gen_active_function = decl;
  gen_stmt(node_a[decl]);
  gen_active_function = old_active_function;
  gen_bind_clear();
}

func gen_struct_decl(id: int): void {
  code_emit(C_KW, 12);
  code_emit(C_IDENT, sym_c_symbol(node_value[id]));
  code_emit(C_PUNCT, 13);
  let f: int = node_a[id];
  while f != 0 {
    gen_decl(node_b[f], node_a[f]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
    f = node_next[f];
  }
  code_emit(C_PUNCT, 14);
  code_emit(C_PUNCT, 12);
  code_emit(C_NEWLINE, 0);
}

func gen_enum_decl(id: int): void {
  code_emit(C_KW, 14);
  code_emit(C_KW, 13);
  code_emit(C_IDENT, sym_c_symbol(node_value[id]));
  code_emit(C_PUNCT, 13);
  let f: int = node_a[id];
  while f != 0 {
    code_emit(C_IDENT, sym_c_symbol(node_a[f]));
    code_emit(C_PUNCT, 11);
    code_emit(C_INT, node_value[f]);
    if node_next[f] != 0 then code_emit(C_PUNCT, 7);
    code_emit(C_NEWLINE, 0);
    f = node_next[f];
  }
  code_emit(C_PUNCT, 14);
  code_emit(C_IDENT, sym_c_symbol(node_value[id]));
  code_emit(C_PUNCT, 12);
  code_emit(C_NEWLINE, 0);
}

func gen_extern_param(ty: int, name: int): void {
  if node_kind[ty] == TY_STRING then {
    code_emit(C_KW, 16);
    code_emit(C_KW, 3);
    code_emit(C_IDENT, sym_c_symbol(name));
  } else gen_decl(ty, name);
}

func gen_function_signature(id: int): void {
  if sym_len[node_value[id]] == 4 && sym_hash[node_value[id]] == 808448 then code_emit(C_KW, 1);
  else gen_type(node_aux[id], node_b[id], 0);
  code_emit(C_IDENT, sym_c_symbol(node_value[id]));
  code_emit(C_PUNCT, 6);
  let param: int = node_c[id];
  while param != 0 {
    if node_kind[id] == N_EXTERN then gen_extern_param(node_b[param], node_a[param]);
    else gen_decl(node_b[param], node_a[param]);
    if node_next[param] != 0 then code_emit(C_PUNCT, 7);
    param = node_next[param];
  }
  code_emit(C_PUNCT, 8);
}

func gen_prototype(id: int): void {
  gen_function_signature(id);
  code_emit(C_PUNCT, 12);
  code_emit(C_NEWLINE, 0);
}

func gen_function(id: int): void {
  gen_function_signature(id);
  if sym_len[node_value[id]] == 4 && sym_hash[node_value[id]] == 808448 && node_kind[node_a[id]] == N_BLOCK then {
    code_emit(C_PUNCT, 13);
    let item: int = node_a[node_a[id]];
    while item != 0 {
      gen_stmt(item);
      item = node_next[item];
    }
    code_emit(C_KW, 5);
    code_emit(C_INT, 0);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
    code_emit(C_PUNCT, 14);
  } else gen_stmt(node_a[id]);
}

func gen_program(id: int): void {
  let gen_saved_node_count: int = node_count;
  code_reset(); gen_spec_count = 0; gen_name_override = 0;
  let item: int = node_a[id];
  while item != 0 {
    if node_kind[item] == N_GLOBAL || node_kind[item] == N_CONST then gen_collect_stmt(item);
    else if node_kind[item] == N_FUNC then {
      gen_collect_type(node_b[item]);
      let pp: int = node_c[item]; while pp != 0 { gen_collect_type(node_b[pp]); pp = node_next[pp]; }
      gen_collect_stmt(node_a[item]);
    }
    item = node_next[item];
  }
  // Forward declarations for ordinary and specialized structs.
  item = node_a[id];
  while item != 0 {
    if node_kind[item] == N_STRUCT then {
      code_emit(C_KW, 14); code_emit(C_KW, 12); code_emit(C_IDENT, sym_c_symbol(node_value[item])); code_emit(C_PUNCT, 22); code_emit(C_IDENT, sym_c_symbol(node_value[item])); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0);
    }
    item = node_next[item];
  }
  let si: int = 0;
  while si < gen_spec_count { if gen_spec_kind[si] == 1 then { code_emit(C_KW, 14); code_emit(C_KW, 12); code_emit(C_IDENT, gen_spec_name[si]); code_emit(C_PUNCT, 22); code_emit(C_IDENT, gen_spec_name[si]); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0); } si = si + 1; }
  // Rescan each discovered generic function instance until nested calls reach a fixed point.
  let scan_si: int = 0;
  while scan_si < gen_spec_count {
    if gen_spec_kind[scan_si] == 2 then {
      let scan_decl: int = gen_spec_decl[scan_si];
      let old_active_scan: int = gen_active_function;
      gen_bind_decl(scan_decl, gen_spec_type[scan_si]);
      gen_active_function = scan_decl;
      gen_collect_stmt(node_a[scan_decl]);
      gen_active_function = old_active_scan;
      gen_bind_clear();
    }
    scan_si = scan_si + 1;
  }
  // Definitions for ordinary and specialized structs.
  item = node_a[id];
  while item != 0 { if node_kind[item] == N_STRUCT then gen_struct_decl(item); else if node_kind[item] == N_ENUM then gen_enum_decl(item); item = node_next[item]; }
  si = 0; while si < gen_spec_count { if gen_spec_kind[si] == 1 then gen_struct_decl_specialized(gen_spec_decl[si], gen_spec_type[si], gen_spec_name[si]); si = si + 1; }
  // Prototypes for ordinary functions, externs and all generic specializations.
  item = node_a[id];
  while item != 0 { if node_kind[item] == N_FUNC || node_kind[item] == N_EXTERN then gen_prototype(item); item = node_next[item]; }
  si = 0; while si < gen_spec_count { if gen_spec_kind[si] == 2 then { gen_bind_decl(gen_spec_decl[si], gen_spec_type[si]); let rr: int = gen_substitute_type(node_b[gen_spec_decl[si]]); gen_type(node_kind[rr], rr, node_value[rr]); code_emit(C_IDENT, gen_spec_name[si]); code_emit(C_PUNCT, 6); let pp: int = node_c[gen_spec_decl[si]]; while pp != 0 { let pt: int = gen_substitute_type(node_b[pp]); gen_decl(pt, node_a[pp]); if node_next[pp] != 0 then code_emit(C_PUNCT, 7); pp = node_next[pp]; } code_emit(C_PUNCT, 8); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0); gen_bind_clear(); } si = si + 1; }
  item = node_a[id]; while item != 0 { if node_kind[item] == N_GLOBAL || node_kind[item] == N_CONST then gen_stmt(item); item = node_next[item]; }
  si = 0; while si < gen_spec_count { if gen_spec_kind[si] == 2 then gen_function_specialized(gen_spec_decl[si], gen_spec_type[si], gen_spec_name[si]); si = si + 1; }
  item = node_a[id]; while item != 0 { if node_kind[item] == N_FUNC then gen_function(item); item = node_next[item]; }
  node_count = gen_saved_node_count;
}

// Regression: build `int main() { print (2 + 3); return 0; }`, generate the
// token IR twice, and compare every emitted token. Expected output is 1.
func build_regression_ast(): int {
  node_count = 1;
  payload_count = 1;
  let two: int = ast_node(N_INT, 0, 0, 0, 2, 0);
  let three: int = ast_node(N_INT, 0, 0, 0, 3, 0);
  let sum: int = ast_node(N_BINOP, two, three, 0, OP_ADD, 0);
  let print_stmt: int = ast_node(N_PRINT, sum, 0, 0, 0, 0);
  let zero: int = ast_node(N_INT, 0, 0, 0, 0, 0);
  let ret: int = ast_node(N_RETURN, zero, 0, 0, 0, 0);
  let body_items: int = ast_link(print_stmt, ret);
  let body: int = ast_node(N_BLOCK, body_items, 0, 0, 0, 0);
  let main_fn: int = ast_node(N_FUNC, body, 0, 0, 1, TY_INT);
  return ast_node(N_PROGRAM, main_fn, 0, 0, 0, 0);
}

func generator_regression_main(): void {
  let program: int = build_regression_ast();
  gen_program(program);
  let first_count: int = code_count;
  let first_kind: int* = alloc_ints(65536);
  let first_value: int* = alloc_ints(65536);
  let i: int = 0;
  while i < first_count {
    first_kind[i] = code_kind[i];
    first_value[i] = code_value[i];
    i = i + 1;
  }
  gen_program(program);
  let same: int = 1;
  i = 0;
  if code_count != first_count then same = 0;
  while i < first_count {
    if code_kind[i] != first_kind[i] then same = 0;
    if code_value[i] != first_value[i] then same = 0;
    i = i + 1;
  }
  if same == 1 then print 1; else print 0;
}


let T_EOF: int = 0;
let T_LET: int = 1;
let T_FUNC: int = 2;
let T_ID: int = 3;
let T_INT: int = 4;
let T_STRING: int = 5;
let T_TRUE: int = 6;
let T_FALSE: int = 7;
let T_RETURN: int = 8;
let T_WHILE: int = 9;
let T_FOR: int = 10;
let T_BREAK: int = 11;
let T_CONTINUE: int = 12;
let T_IF: int = 13;
let T_THEN: int = 14;
let T_ELSE: int = 15;
let T_PRINT: int = 16;
let T_TINT: int = 17;
let T_TBOOL: int = 18;
let T_TSTRING: int = 19;
let T_TVOID: int = 20;
let T_PLUS: int = 21;
let T_MINUS: int = 22;
let T_STAR: int = 23;
let T_DIVIDE: int = 24;
let T_CONCAT: int = 25;
let T_AND_AND: int = 26;
let T_OR_OR: int = 27;
let T_EQUAL: int = 28;
let T_EQEQ: int = 29;
let T_NEQ: int = 30;
let T_LT: int = 31;
let T_GT: int = 32;
let T_COLON: int = 33;
let T_LPAREN: int = 34;
let T_RPAREN: int = 35;
let T_LBRACE: int = 36;
let T_RBRACE: int = 37;
let T_SEMI: int = 38;
let T_COMMA: int = 39;
let T_AMP: int = 40;
let T_LBRACK: int = 41;
let T_RBRACK: int = 42;
let T_STRUCT: int = 43;
let T_ENUM: int = 44;
let T_DOT: int = 45;
let T_CHAR: int = 46;
let T_NULL: int = 47;
let T_CONST: int = 48;
let T_TCHAR: int = 49;
let T_FLOAT: int = 50;
let T_TDOUBLE: int = 51;
let T_BITOR: int = 52;
let T_BITXOR: int = 53;
let T_BITNOT: int = 54;
let T_SHL: int = 55;
let T_SHR: int = 56;
let T_FN: int = 57;
let T_EXTERN: int = 58;
let T_ARRAY: int = 59;
let T_NAMESPACE: int = 60;
let T_SCOPE: int = 61;
let T_MOD: int = 62;

let input_kind: int* = 0;
let input_value: int* = 0;
let input_count: int = 0;
let input_pos: int = 0;
let debug_tokens: int = 0;
let for_step_context: int = 0;

func input_reset(): void {
  input_count = 0;
  input_pos = 0;
}

func input_put(kind: int, value: int): void {
  ensure_input(input_count);
  input_kind[input_count] = kind;
  input_value[input_count] = value;
  input_count = input_count + 1;
}

func input_peek(): int {
  if input_pos < input_count then return input_kind[input_pos];
  else return T_EOF;
}

func input_payload(): int {
  if input_pos < input_count then return input_value[input_pos];
  else return 0;
}

func input_take(kind: int): int {
  if input_peek() == kind then {
    input_pos = input_pos + 1;
    return 1;
  } else return 0;
}

let ast_generic_scope: int = 0;

func ast_generic_param(name: int): int {
  let p: int = ast_generic_scope;
  while p != 0 {
    if node_a[p] == name then return 1;
    p = node_next[p];
  }
  return 0;
}

func ast_generic_params(): int {
  let params: int = 0;
  if input_take(T_LT) == 0 then return 0;
  while 1 == 1 {
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload(); input_pos = input_pos + 1;
    let p: int = ast_node(N_PARAM, name, 0, 0, 0, 0);
    if params == 0 then params = p; else params = ast_link(params, p);
    if input_take(T_COMMA) == 1 then { }
    else break;
  }
  if input_take(T_GT) == 0 then return (0 - 1);
  return params;
}

func ast_type(): int {
  let base: int = 0;
  let named: int = 0;
  let ty: int = 0;
  if input_take(T_FN) == 1 then {
    if input_take(T_LPAREN) == 0 then return 0;
    let args: int = 0;
    if input_peek() != T_RPAREN then {
      let at: int = ast_type();
      if at == 0 then return 0;
      args = at;
      while input_take(T_COMMA) == 1 {
        at = ast_type();
        if at == 0 then return 0;
        args = ast_link(args, at);
      }
    }
    if input_take(T_RPAREN) == 0 then return 0;
    if input_take(T_COLON) == 0 then return 0;
    let ret: int = ast_type();
    if ret == 0 then return 0;
    return ast_node(TY_FUN, args, ret, 0, 0, 0);
  }
  if input_peek() == T_ARRAY && input_pos + 1 < input_count && input_kind[input_pos + 1] == T_SCOPE then {
    let ns: int = input_payload(); input_pos = input_pos + 2;
    if input_peek() != T_ID && input_peek() != T_ARRAY then return 0;
    let rhs: int = input_payload(); input_pos = input_pos + 1;
    let named_type: int = sym_qualified(ns, rhs);
    if input_take(T_LT) == 1 then {
      let args: int = 0;
      if input_peek() != T_GT then {
        let at: int = ast_type();
        if at == 0 then return 0;
        args = at;
        while input_take(T_COMMA) == 1 {
          at = ast_type();
          if at == 0 then return 0;
          args = ast_link(args, at);
        }
      }
      if input_take(T_GT) == 0 then return 0;
      ty = ast_node(TY_GENERIC, args, 0, 0, named_type, 0);
    } else ty = ast_node(TY_NAMED, 0, 0, 0, named_type, 0);
  } else {
    if input_take(T_TINT) == 1 then base = TY_INT;
    else if input_take(T_TBOOL) == 1 then base = TY_BOOL;
    else if input_take(T_TSTRING) == 1 then base = TY_STRING;
    else if input_take(T_TCHAR) == 1 then base = TY_CHAR;
    else if input_take(T_FLOAT) == 1 then base = TY_FLOAT;
    else if input_take(T_TDOUBLE) == 1 then base = TY_DOUBLE;
    else if input_take(T_TVOID) == 1 then base = TY_VOID;
    else if input_peek() == T_ID then {
                named = input_payload();
          input_pos = input_pos + 1;
          if input_take(T_SCOPE) == 1 then {
            if input_peek() != T_ID then return 0;
            let rhs: int = input_payload(); input_pos = input_pos + 1;
            named = sym_qualified(named, rhs);
          } else named = ast_type_name(named);
          if input_peek() == T_LT then {

        let args: int = 0;
        input_pos = input_pos + 1;
        if input_peek() != T_GT then {
          let at: int = ast_type();
          if at == 0 then return 0;
          args = at;
          while input_take(T_COMMA) == 1 {
            at = ast_type();
            if at == 0 then return 0;
            args = ast_link(args, at);
          }
        }
        if input_take(T_GT) == 0 then return 0;
        ty = ast_node(TY_GENERIC, args, 0, 0, named, 0);
      } else if ast_generic_param(named) == 1 then ty = ast_node(TY_PARAM, 0, 0, 0, named, 0);
      else ty = ast_node(TY_NAMED, 0, 0, 0, named, 0);
    } else return 0;
    if ty == 0 then ty = ast_node(base, 0, 0, 0, named, 0);
  }
  while input_take(T_STAR) == 1 {
    ty = ast_node(TY_PTR, ty, 0, 0, 0, 0);
  }
  while input_take(T_LBRACK) == 1 {
    if input_peek() != T_INT then return 0;
    let size: int = input_payload();
    input_pos = input_pos + 1;
    if input_take(T_RBRACK) == 0 then return 0;
    ty = ast_node(TY_ARRAY, ty, 0, 0, size, 0);
  }
  return ty;
}

func ast_call_args(): int {
  let args: int = 0;
  if input_peek() != T_RPAREN then {
    let arg: int = ast_expr();
    if arg < 0 then return (0 - 1);
    args = arg;
    while input_take(T_COMMA) == 1 {
      arg = ast_expr();
      if arg < 0 then return (0 - 1);
      args = ast_link(args, arg);
    }
  }
  if input_take(T_RPAREN) == 0 then return (0 - 1);
  return args;
}

func ast_primary(): int {
  if input_peek() == T_CHAR then {
    let value: int = input_payload(); input_pos = input_pos + 1;
    return ast_node(N_CHAR, 0, 0, 0, value, 0);
  }
  if input_take(T_NULL) == 1 then return ast_node(N_NULL, 0, 0, 0, 0, 0);
  if input_peek() == T_FLOAT then { let value: int = input_payload(); input_pos = input_pos + 1; return ast_node(N_FLOAT, 0, 0, 0, value, 0); }
  if input_peek() == T_INT then {
    let value: int = input_payload();
    input_pos = input_pos + 1;
    return ast_node(N_INT, 0, 0, 0, value, 0);
  }
  if input_peek() == T_STRING then {
    let value: int = input_payload();
    input_pos = input_pos + 1;
    return ast_node(N_STRING, 0, 0, 0, value, 0);
  }
  if input_take(T_TRUE) == 1 then return ast_node(N_BOOL, 0, 0, 0, 1, 0);
  if input_take(T_FALSE) == 1 then return ast_node(N_BOOL, 0, 0, 0, 0, 0);
  if input_peek() == T_ID || input_peek() == T_ARRAY then {
    let name: int = input_payload();
    input_pos = input_pos + 1;
    while input_take(T_SCOPE) == 1 {
      if input_peek() != T_ID && input_peek() != T_ARRAY then return (0 - 1);
      let rhs: int = input_payload(); input_pos = input_pos + 1;
      name = sym_qualified(name, rhs);
    }
    if input_take(T_LPAREN) == 1 then {
      let args: int = ast_call_args();
      if args < 0 then return (0 - 1);
      return ast_node(N_CALL, args, 0, 0, name, 0);
    }
    let base: int = ast_node(N_VAR, 0, 0, 0, name, 0);
    if input_take(T_DOT) == 1 then {
      if input_peek() != T_ID then return (0 - 1);
      let field: int = input_payload();
      input_pos = input_pos + 1;
      let field_expr: int = ast_node(N_FIELD_ACCESS, base, 0, 0, field, 0);
      if input_take(T_LPAREN) == 1 then {
        let args: int = ast_call_args();
        if args < 0 then return (0 - 1);
        return ast_node(N_INDIRECT_CALL, field_expr, args, 0, 0, 0);
      }
      return field_expr;
    }
    return base;
  }
  if input_take(T_LPAREN) == 1 then {
    let e: int = ast_expr();
    if e < 0 then return (0 - 1);
    if input_take(T_RPAREN) == 0 then return (0 - 1);
    if input_take(T_LPAREN) == 1 then {
      let args: int = ast_call_args();
      if args < 0 then return (0 - 1);
      return ast_node(N_INDIRECT_CALL, e, args, 0, 0, 0);
    }
    return e;
  }
  return (0 - 1);
}

func ast_unary(): int {
  if input_take(T_MINUS) == 1 then {
    let e: int = ast_unary();
    if e < 0 then return (0 - 1);
    let zero: int = ast_node(N_INT, 0, 0, 0, 0, 0);
    return ast_node(N_BINOP, zero, e, 0, OP_SUB, 0);
  }
  if input_take(T_BITNOT) == 1 then { let e: int = ast_unary(); if e < 0 then return (0 - 1); let allbits: int = ast_node(N_INT, 0, 0, 0, (0 - 1), 0); return ast_node(N_BINOP, e, allbits, 0, OP_BITXOR, 0); }
  if input_take(T_STAR) == 1 then {
    let e: int = ast_unary();
    if e < 0 then return (0 - 1);
    return ast_node(N_DEREF, e, 0, 0, 0, 0);
  }
  if input_take(T_AMP) == 1 then {
    let e: int = ast_unary();
    if e < 0 then return (0 - 1);
    return ast_node(N_ADDRESS, e, 0, 0, 0, 0);
  }
  return ast_primary();
}

func ast_precedence(kind: int): int {
  if kind == T_OR_OR then return 1;
  if kind == T_AND_AND then return 2;
  if kind == T_EQEQ then return 3;
  if kind == T_NEQ then return 3;
  if kind == T_LT then return 3;
  if kind == T_GT then return 3;
  if kind == T_CONCAT then return 4;
  if kind == T_BITOR then return 5;
  if kind == T_BITXOR then return 6;
  if kind == T_AMP then return 7;
  if kind == T_SHL then return 8;
  if kind == T_SHR then return 8;
  if kind == T_PLUS then return 9;
  if kind == T_MINUS then return 9;
  if kind == T_STAR then return 10;
  if kind == T_DIVIDE then return 10;
  if kind == T_MOD then return 10;
  return 0;
}

func ast_operator(kind: int): int {
  if kind == T_PLUS then return OP_ADD;
  if kind == T_MINUS then return OP_SUB;
  if kind == T_STAR then return OP_MUL;
  if kind == T_DIVIDE then return OP_DIV;
  if kind == T_MOD then return OP_MOD;
  if kind == T_EQEQ then return OP_EQ;
  if kind == T_NEQ then return OP_NEQ;
  if kind == T_LT then return OP_LT;
  if kind == T_GT then return OP_GT;
  if kind == T_AND_AND then return OP_AND;
  if kind == T_OR_OR then return OP_OR;
  if kind == T_CONCAT then return OP_CONCAT;
  if kind == T_AMP then return OP_BITAND;
  if kind == T_BITOR then return OP_BITOR;
  if kind == T_BITXOR then return OP_BITXOR;
  if kind == T_SHL then return OP_SHL;
  if kind == T_SHR then return OP_SHR;
  return OP_GT;
}

func ast_expr_prec(min_prec: int): int {
  let left: int = ast_unary();
  if left < 0 then return (0 - 1);
  while 1 == 1 {
    if input_take(T_LBRACK) == 1 then {
      let index: int = ast_expr();
      if index < 0 then return (0 - 1);
      if input_take(T_RBRACK) == 0 then return (0 - 1);
      left = ast_node(N_INDEX, left, index, 0, 0, 0);
    } else {
      let p: int = ast_precedence(input_peek());
      if p < min_prec then return left;
      let op_token: int = input_peek();
      input_pos = input_pos + 1;
      let right: int = ast_expr_prec(p + 1);
      if right < 0 then return (0 - 1);
      left = ast_node(N_BINOP, left, right, 0, ast_operator(op_token), 0);
    }
  }
  return left;
}

func ast_expr(): int {
  return ast_expr_prec(1);
}

func clone_for_step(step: int): int {
  return ast_node(node_kind[step], node_a[step], node_b[step], node_c[step], node_value[step], node_aux[step]);
}

func lower_for_stmt(id: int, step: int): int {
  if node_kind[id] == N_CONTINUE then {
    let s: int = clone_for_step(step);
    let c: int = ast_node(N_CONTINUE, 0, 0, 0, 0, 0);
    return ast_node(N_BLOCK, ast_link(s, c), 0, 0, 0, 0);
  }
  if node_kind[id] == N_IF then {
    let yes: int = lower_for_stmt(node_b[id], step);
    let no: int = lower_for_stmt(node_c[id], step);
    return ast_node(N_IF, node_a[id], yes, no, node_value[id], node_aux[id]);
  }
  if node_kind[id] == N_BLOCK then {
    let item: int = node_a[id];
    let out: int = 0;
    while item != 0 {
      let x: int = lower_for_stmt(item, step);
      if out == 0 then out = x; else out = ast_link(out, x);
      item = node_next[item];
    }
    return ast_node(N_BLOCK, out, 0, 0, 0, 0);
  }
  return id;
}

func ast_stmt(): int {
  if input_take(T_BREAK) == 1 then {
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_BREAK, 0, 0, 0, 0, 0);
  }
  if input_take(T_CONTINUE) == 1 then {
    if input_take(T_SEMI) == 0 then return (0 - 1);
    if for_step_context != 0 then {
      let s: int = clone_for_step(for_step_context);
      let c: int = ast_node(N_CONTINUE, 0, 0, 0, 0, 0);
      return ast_node(N_BLOCK, ast_link(s, c), 0, 0, 0, 0);
    }
    return ast_node(N_CONTINUE, 0, 0, 0, 0, 0);
  }
  if input_take(T_LET) == 1 then {
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload();
    input_pos = input_pos + 1;
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ty: int = ast_type();
    if ty == 0 then return (0 - 1);
    if input_take(T_EQUAL) == 0 then return (0 - 1);
    let value: int = ast_expr();
    if value < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_LET, name, ty, value, 0, node_kind[ty]);
  }
  if input_take(T_PRINT) == 1 then {
    let value: int = ast_expr();
    if value < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_PRINT, value, 0, 0, 0, 0);
  }
  if input_take(T_IF) == 1 then {
    let cond: int = ast_expr();
    if cond < 0 then return (0 - 1);
    if input_take(T_THEN) == 0 then return (0 - 1);
    let yes: int = ast_stmt();
    if yes < 0 then return (0 - 1);
    let no: int = 0;
    if input_take(T_ELSE) == 1 then {
      no = ast_stmt();
      if no < 0 then return (0 - 1);
    } else {
      no = ast_node(N_BLOCK, 0, 0, 0, 0, 0);
    }
    return ast_node(N_IF, cond, yes, no, 0, 0);
  }
  if input_take(T_FOR) == 1 then {
    if input_take(T_LPAREN) == 0 then return (0 - 1);
    let init: int = 0;
    if input_peek() != T_SEMI then {
      if input_take(T_LET) == 1 then {
        if input_peek() != T_ID then return (0 - 1);
        let n: int = input_payload(); input_pos = input_pos + 1;
        if input_take(T_COLON) == 0 then return (0 - 1);
        let t: int = ast_type();
        if t == 0 then return (0 - 1);
        if input_take(T_EQUAL) == 0 then return (0 - 1);
        let v: int = ast_expr();
        init = ast_node(N_LET, n, t, v, 0, node_kind[t]);
      } else {
        let l: int = ast_expr();
        if l < 0 then return (0 - 1);
        if input_take(T_EQUAL) == 0 then return (0 - 1);
        let r: int = ast_expr();
        init = ast_node(N_ASSIGN, l, r, 0, 0, 0);
      }
    }
    if input_take(T_SEMI) == 0 then return (0 - 1);
    let cond: int = ast_expr();
    if input_take(T_SEMI) == 0 then return (0 - 1);
    let step: int = 0;
    if input_peek() != T_RPAREN then {
      let l: int = ast_expr();
      if l < 0 then return (0 - 1);
      if input_take(T_EQUAL) == 1 then {
        let r: int = ast_expr();
        step = ast_node(N_ASSIGN, l, r, 0, 0, 0);
      } else step = ast_node(N_EXPR, l, 0, 0, 0, 0);
    } else step = ast_node(N_BLOCK, 0, 0, 0, 0, 0);
    if input_take(T_RPAREN) == 0 then return (0 - 1);
    if input_take(T_LBRACE) == 0 then return (0 - 1);
    for_step_context = step;
    let items: int = 0;
    while input_peek() != T_RBRACE {
      if input_peek() == T_EOF then return (0 - 1);
      let x: int = ast_stmt();
      if x < 0 then return (0 - 1);
      if items == 0 then items = x; else items = ast_link(items, x);
    }
    if input_take(T_RBRACE) == 0 then return (0 - 1);
    for_step_context = 0;
    let body: int = ast_node(N_BLOCK, items, 0, 0, 0, 0);
    return ast_node(N_FOR, init, cond, body, step, 0);
  }
  if input_take(T_WHILE) == 1 then {
    let cond: int = ast_expr();
    if cond < 0 then return (0 - 1);
    if input_take(T_LBRACE) == 0 then return (0 - 1);
    let items: int = 0;
    while input_peek() != T_RBRACE {
      if input_peek() == T_EOF then return (0 - 1);
      let item: int = ast_stmt();
      if item < 0 then return (0 - 1);
      if items == 0 then items = item; else items = ast_link(items, item);
    }
    if input_take(T_RBRACE) == 0 then return (0 - 1);
    let body: int = ast_node(N_BLOCK, items, 0, 0, 0, 0);
    return ast_node(N_WHILE, cond, body, 0, 0, 0);
  }
  if input_take(T_LBRACE) == 1 then {
    let items: int = 0;
    while input_peek() != T_RBRACE {
      if input_peek() == T_EOF then return (0 - 1);
      let item: int = ast_stmt();
      if item < 0 then return (0 - 1);
      if items == 0 then items = item; else items = ast_link(items, item);
    }
    if input_take(T_RBRACE) == 0 then return (0 - 1);
    return ast_node(N_BLOCK, items, 0, 0, 0, 0);
  }
  if input_take(T_RETURN) == 1 then {
    let value: int = 0;
    if input_peek() != T_SEMI then {
      value = ast_expr();
      if value < 0 then return (0 - 1);
    }
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_RETURN, value, 0, 0, 0, 0);
  }
  let left: int = ast_expr();
  if left < 0 then return (0 - 1);
  if input_take(T_EQUAL) == 1 then {
    let right: int = ast_expr();
    if right < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_ASSIGN, left, right, 0, 0, 0);
  }
  if input_take(T_SEMI) == 0 then return (0 - 1);
  return ast_node(N_EXPR, left, 0, 0, 0, 0);
}

func ast_params(): int {
  let params: int = 0;
  if input_peek() == T_RPAREN then return 0;
  while 1 == 1 {
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload();
    input_pos = input_pos + 1;
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ty: int = ast_type();
    if ty == 0 then return (0 - 1);
    let param: int = ast_node(N_PARAM, name, ty, 0, 0, node_kind[ty]);
    if params == 0 then params = param; else params = ast_link(params, param);
    if input_take(T_COMMA) == 0 then return params;
  }
}

func ast_struct_decl(): int {
  if input_peek() != T_ID then return (0 - 1);
  let name: int = input_payload(); input_pos = input_pos + 1;
  name = ast_decl_name(name);
  let params: int = 0;
  let old_scope: int = ast_generic_scope;
  if input_peek() == T_LT then {
    params = ast_generic_params();
    if params < 0 then return (0 - 1);
    ast_generic_scope = params;
  }
  if input_take(T_LBRACE) == 0 then return (0 - 1);
  let fields: int = 0;
  while input_peek() != T_RBRACE {
    if input_peek() == T_EOF then return (0 - 1);
    if input_peek() != T_ID then return (0 - 1);
    let field_name: int = input_payload(); input_pos = input_pos + 1;
    if input_take(T_COLON) == 0 then return (0 - 1);
    let field_type: int = ast_type();
    if field_type == 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    let field: int = ast_node(N_FIELD, field_name, field_type, 0, 0, 0);
    if fields == 0 then fields = field; else fields = ast_link(fields, field);
  }
  if input_take(T_RBRACE) == 0 then return (0 - 1);
  if input_take(T_SEMI) == 1 then { }
  ast_generic_scope = old_scope;
  if params == 0 then return ast_node(N_STRUCT, fields, 0, 0, name, 0);
  return ast_node(N_GENERIC_STRUCT, fields, 0, params, name, 0);
}

func ast_enum_decl(): int {
  if input_peek() != T_ID then return (0 - 1);
  let name: int = input_payload(); input_pos = input_pos + 1;
  name = ast_decl_name(name);
  if input_take(T_LBRACE) == 0 then return (0 - 1);
  let values: int = 0;
  let ordinal: int = 0;
  while input_peek() != T_RBRACE {
    if input_peek() == T_EOF then return (0 - 1);
    if input_peek() != T_ID then return (0 - 1);
    let member: int = input_payload(); input_pos = input_pos + 1;
    let item: int = ast_node(N_FIELD, member, 0, 0, ordinal, 0);
    if values == 0 then values = item; else values = ast_link(values, item);
    ordinal = ordinal + 1;
    if input_take(T_COMMA) == 0 then { }
  }
  if input_take(T_RBRACE) == 0 then return (0 - 1);
  if input_take(T_SEMI) == 1 then { }
  return ast_node(N_ENUM, values, 0, 0, name, 0);
}

func ast_namespace_decl(): int {
  if input_peek() != T_ID && input_peek() != T_ARRAY then return (0 - 1);
  let raw: int = input_payload(); input_pos = input_pos + 1;
  let ns: int = raw;
  if ast_namespace_scope != 0 then ns = sym_qualified(ast_namespace_scope, raw);
  if input_take(T_LBRACE) == 0 then return (0 - 1);
  let old_ns: int = ast_namespace_scope;
  ast_namespace_scope = ns;
  let items: int = 0;
  while input_peek() != T_RBRACE {
    if input_peek() == T_EOF then { ast_namespace_scope = old_ns; return (0 - 1); }
    let item: int = ast_decl();
    if item < 0 then { ast_namespace_scope = old_ns; return (0 - 1); }
    if items == 0 then items = item; else items = ast_link(items, item);
  }
  if input_take(T_RBRACE) == 0 then { ast_namespace_scope = old_ns; return (0 - 1); }
  if input_take(T_SEMI) == 1 then { }
  ast_namespace_scope = old_ns;
  return ast_node(N_LIST, items, 0, 0, 0, 0);
}

func ast_decl(): int {
  if input_take(T_NAMESPACE) == 1 then return ast_namespace_decl();
  if input_take(T_EXTERN) == 1 then {
    if input_take(T_FUNC) == 0 then return (0 - 1);
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload(); input_pos = input_pos + 1;
    name = ast_decl_name(name);
    if input_take(T_LPAREN) == 0 then return (0 - 1);
    let params: int = ast_params();
    if params < 0 then return (0 - 1);
    if input_take(T_RPAREN) == 0 then return (0 - 1);
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ret_ty: int = ast_type();
    if ret_ty == 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_EXTERN, 0, ret_ty, params, name, node_kind[ret_ty]);
  }
  if input_take(T_CONST) == 1 then {
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload(); input_pos = input_pos + 1;
    name = ast_decl_name(name);
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ty: int = ast_type(); if ty == 0 then return (0 - 1);
    if input_take(T_EQUAL) == 0 then return (0 - 1);
    let value: int = ast_expr(); if value < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_CONST, name, ty, value, 0, node_kind[ty]);
  }
  if input_take(T_STRUCT) == 1 then return ast_struct_decl();
  if input_take(T_ENUM) == 1 then return ast_enum_decl();
  if input_take(T_LET) == 1 then {
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload();
    input_pos = input_pos + 1;
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ty: int = ast_type();
    if ty == 0 then return (0 - 1);
    if input_take(T_EQUAL) == 0 then return (0 - 1);
    let value: int = ast_expr();
    if value < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_GLOBAL, name, ty, value, 0, node_kind[ty]);
  }
  if input_take(T_FUNC) == 1 then {
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload();
    input_pos = input_pos + 1;
    name = ast_decl_name(name);
    let generic_params: int = 0;
    let old_scope: int = ast_generic_scope;
    if input_peek() == T_LT then {
      generic_params = ast_generic_params();
      if generic_params < 0 then return (0 - 1);
      ast_generic_scope = generic_params;
    }
    if input_take(T_LPAREN) == 0 then return (0 - 1);
    let params: int = ast_params();
    if params < 0 then return (0 - 1);
    if input_take(T_RPAREN) == 0 then return (0 - 1);
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ret_ty: int = ast_type();
    if ret_ty == 0 then return (0 - 1);
    let body: int = ast_stmt();
    if body < 0 then return (0 - 1);
    ast_generic_scope = old_scope;
    if generic_params == 0 then return ast_node(N_FUNC, body, ret_ty, params, name, node_kind[ret_ty]);
    return ast_node(N_GENERIC_FUNC, body, ret_ty, params, name, generic_params);
  }
  return (0 - 1);
}

func ast_program(): int {
  let items: int = 0;
  while input_peek() != T_EOF {
    let item: int = ast_decl();
    if item < 0 then return (0 - 1);
    if node_kind[item] == N_LIST then {
      let nested: int = node_a[item];
      if nested != 0 then {
        if items == 0 then items = nested;
        else {
          let tail: int = items;
          while node_next[tail] != 0 { tail = node_next[tail]; }
          node_next[tail] = nested;
        }
      }
    } else if items == 0 then items = item; else items = ast_link(items, item);
  }
  return ast_node(N_PROGRAM, items, 0, 0, 0, 0);
}

let L_EOF: int = 0;
let L_ID: int = 1;
let L_INT: int = 2;
let L_FUNC: int = 3;
let L_LET: int = 4;
let L_PRINT: int = 5;
let L_RETURN: int = 6;
let L_IF: int = 7;
let L_ELSE: int = 8;
let L_WHILE: int = 9;
let L_TRUE: int = 10;
let L_FALSE: int = 11;
let L_TINT: int = 12;
let L_TBOOL: int = 13;
let L_TSTRING: int = 14;
let L_STRING: int = 35;
let L_TVOID: int = 15;
let L_THEN: int = 37;
let L_AMP: int = 34;
let L_PLUS: int = 16;
let L_MINUS: int = 17;
let L_STAR: int = 18;
let L_DIV: int = 19;
let L_EQ: int = 20;
let L_EQEQ: int = 21;
let L_NEQ: int = 22;
let L_LT: int = 23;
let L_GT: int = 24;
let L_LPAREN: int = 25;
let L_RPAREN: int = 26;
let L_LBRACE: int = 27;
let L_RBRACE: int = 28;
let L_COLON: int = 29;
let L_SEMI: int = 30;
let L_COMMA: int = 31;
let L_LBRACK: int = 32;
let L_RBRACK: int = 33;
let L_FOR: int = 38;
let L_BREAK: int = 39;
let L_CONTINUE: int = 40;
let L_CONCAT: int = 41;
let L_AND: int = 42;
let L_OR: int = 43;
let L_STRUCT: int = 44;
let L_ENUM: int = 45;
let L_DOT: int = 46;
let L_CHAR: int = 47;
let L_NULL: int = 48;
let L_CONST: int = 49;
let L_TCHAR: int = 50;
let L_FLOAT: int = 51;
let L_TFLOAT: int = 52;
let L_TDOUBLE: int = 53;
let L_BITOR: int = 54;
let L_BITXOR: int = 55;
let L_BITNOT: int = 56;
let L_SHL: int = 57;
let L_SHR: int = 58;
let L_FN: int = 59;
let L_EXTERN: int = 60;
let L_ARRAY: int = 61;
let L_NAMESPACE: int = 62;
let L_SCOPE: int = 63;
let L_MOD: int = 64;

let source: int* = 0;
let source_len: int = 0;
let source_pos: int = 0;
let c_source: int* = 0;
let c_source_len: int = 0;
let include_ok: int = 1;
let include_line_cap: int = 4096;

func c_source_reset(): void { c_source_len = 0; }
func ensure_c_source(need: int): void {
  if need < c_source_cap then return;
  let n: int = next_capacity(c_source_cap, need);
  c_source = grow_ints(c_source, c_source_cap, n);
  c_source_cap = n;
}
func c_source_put(c: int): void {
  ensure_c_source(c_source_len);
  c_source[c_source_len] = c;
  c_source_len = c_source_len + 1;
}


func source_reset(): void {
  source_len = 0;
  source_pos = 0;
}

func source_put(c: int): void {
  ensure_source(source_len);
  source[source_len] = c;
  source_len = source_len + 1;
}

func is_space(c: int): int {
  if c == 32 then return 1;
  if c == 9 then return 1;
  if c == 10 then return 1;
  if c == 13 then return 1;
  return 0;
}

func is_digit(c: int): int {
  if c < 48 then return 0;
  if c > 57 then return 0;
  return 1;
}

func is_alpha(c: int): int {
  if c > 64 then {
    if c < 91 then return 1;
  }
  if c > 96 then {
    if c < 123 then return 1;
  }
  if c == 95 then return 1;
  return 0;
}

func is_alnum(c: int): int {
  if is_alpha(c) == 1 then return 1;
  return is_digit(c);
}

func source_peek(): int {
  if source_pos < source_len then return source[source_pos];
  return 0;
}

func source_take(): int {
  let c: int = source_peek();
  if source_pos < source_len then source_pos = source_pos + 1;
  current_source_pos = source_pos;
  return c;
}

let sym_start: int* = 0;
let sym_len: int* = 0;
let sym_hash: int* = 0;
let sym_kind: int* = 0;
let sym_type: int* = 0;
let sym_elem_kind: int* = 0;
let sym_elem_name: int* = 0;
let sym_scope: int* = 0;
let sym_count: int = 1;
let sym_text_len: int = 0;

func span_hash(start: int, length: int): int {
  let i: int = 0;
  let h: int = 7;
  while i < length {
    h = h * 31 + source[start + i];
    if h > 1000000 then h = h - (h / 1000000) * 1000000;
    i = i + 1;
  }
  return h;
}

func span_equal(a: int, b: int, length: int): int {
  let i: int = 0;
  while i < length {
    if source[a + i] != source[b + i] then return 0;
    i = i + 1;
  }
  return 1;
}

func sym_lookup(start: int, length: int, h: int): int {
  let i: int = 1;
  while i < sym_count {
    if sym_len[i] == length then {
      if sym_hash[i] == h then {
        if span_equal(sym_start[i], start, length) == 1 then return i;
      }
    }
    i = i + 1;
  }
  return 0;
}

func sym_qualified(ns: int, name: int): int {
  if ns == 0 then return name;
  let start: int = source_len + sym_text_len;
  let out: int = 0;
  let i: int = 0;
  while i < sym_len[ns] { ensure_source(start + out); source[start + out] = source[sym_start[ns] + i]; out = out + 1; i = i + 1; }
  ensure_source(start + out); source[start + out] = 58; out = out + 1;
  ensure_source(start + out); source[start + out] = 58; out = out + 1;
  i = 0;
  while i < sym_len[name] { ensure_source(start + out); source[start + out] = source[sym_start[name] + i]; out = out + 1; i = i + 1; }
  let id: int = sym_intern(start, out, L_ID, 0);
  sym_text_len = sym_text_len + out;
  return id;
}

func ast_decl_name(name: int): int {
  if ast_namespace_scope == 0 then return name;
  return sym_qualified(ast_namespace_scope, name);
}

func ast_type_name(name: int): int {
  if ast_generic_param(name) == 1 then return name;
  if ast_namespace_scope == 0 then return name;
  return sym_qualified(ast_namespace_scope, name);
}

func sym_intern(start: int, length: int, kind: int, scope: int): int {
  let h: int = span_hash(start, length);
  let old: int = sym_lookup(start, length, h);
  if old != 0 then return old;
  let id: int = sym_count;
  ensure_sym(id);
  sym_start[id] = start;
  sym_len[id] = length;
  sym_hash[id] = h;
  sym_kind[id] = kind;
  sym_scope[id] = scope;
  sym_type[id] = 0;
  sym_elem_kind[id] = 0;
  sym_elem_name[id] = 0;
  sym_count = sym_count + 1;
  return id;
}

func word_code(start: int, length: int): int {
  let h: int = span_hash(start, length);
  if length == 2 then {
    if h == 10084 then return L_IF;
    if h == 9999 then return L_FN;
  }
  if length == 3 then {
    if h == 315572 then return L_LET;
    if h == 312968 then return L_TINT;
    if h == 310114 then return L_FOR;
  }
  if length == 4 then {
    if h == 619275 then return L_FUNC;
    if h == 580992 then return L_ELSE;
    if h == 582984 then return L_ENUM;
    if h == 33685 then return L_TRUE;
    if h == 494385 then return L_TBOOL;
    if h == 90011 then return L_TVOID;
    if h == 23588 then return L_THEN;
  }
  if length == 5 then {
    if h == 339014 then return L_PRINT;
    if h == 505674 then return L_WHILE;
    if h == 600380 then return L_FALSE;
    if h == 405464 then return L_BREAK;
  }
  if length == 8 then {
    if source[start] == 99 then {
      if source[start + 1] == 111 then {
        if source[start + 2] == 110 then {
          if source[start + 3] == 116 then {
            if source[start + 4] == 105 then {
              if source[start + 5] == 110 then {
                if source[start + 6] == 117 then {
                  if source[start + 7] == 101 then return L_CONTINUE;
                }
              }
            }
          }
        }
      }
    }
  }
  if length == 4 then {
    if source[start] == 110 && source[start + 1] == 117 && source[start + 2] == 108 && source[start + 3] == 108 then return L_NULL;
    if source[start] == 99 && source[start + 1] == 104 && source[start + 2] == 97 && source[start + 3] == 114 then return L_TCHAR;
  }
  if length == 5 then {
    if source[start] == 99 && source[start + 1] == 111 && source[start + 2] == 110 && source[start + 3] == 115 && source[start + 4] == 116 then return L_CONST;
    if source[start] == 97 && source[start + 1] == 114 && source[start + 2] == 114 && source[start + 3] == 97 && source[start + 4] == 121 then return L_ARRAY;
  }
  if length == 6 then {
    if h == 448999 then return L_EXTERN;
    if source[start] == 114 then {
      if source[start + 1] == 101 then {
        if source[start + 2] == 116 then {
          if source[start + 3] == 117 then {
            if source[start + 4] == 114 then {
              if source[start + 5] == 110 then return L_RETURN;
            }
          }
        }
      }
    }
    if source[start] == 115 then {
      if source[start + 1] == 116 then {
        if source[start + 2] == 114 then {
          if source[start + 3] == 117 then {
            if source[start + 4] == 99 then {
              if source[start + 5] == 116 then return L_STRUCT;
            }
          }
        }
      }
    }
    if source[start] == 115 then {
      if source[start + 1] == 116 then {
        if source[start + 2] == 114 then {
          if source[start + 3] == 105 then {
            if source[start + 4] == 110 then {
              if source[start + 5] == 103 then return L_TSTRING;
            }
          }
        }
      }
    }
  }
  if length == 5 then { if source[start] == 102 && source[start+1] == 108 && source[start+2] == 111 && source[start+3] == 97 && source[start+4] == 116 then return L_TFLOAT; }
  if length == 9 then { if source[start] == 110 && source[start+1] == 97 && source[start+2] == 109 && source[start+3] == 101 && source[start+4] == 115 && source[start+5] == 112 && source[start+6] == 97 && source[start+7] == 99 && source[start+8] == 101 then return L_NAMESPACE; }
  if length == 6 then { if source[start] == 100 && source[start+1] == 111 && source[start+2] == 117 && source[start+3] == 98 && source[start+4] == 108 && source[start+5] == 101 then return L_TDOUBLE; }
  return L_ID;
}

let tok_kind: int = 0;
let tok_value: int = 0;
let tok_start: int = 0;
let tok_length: int = 0;

func lexer_skip(): void {
  while is_space(source_peek()) == 1 {
    source_take();
  }
  if source_peek() == 47 then {
    if source_pos + 1 < source_len then {
      if source[source_pos + 1] == 47 then {
        while source_peek() != 10 {
          if source_pos > source_len - 1 then return;
          source_take();
        }
        lexer_skip();
      }
    }
  }
}

func lexer_next(): int {
  lexer_skip();
  tok_start = source_pos;
  tok_length = 0;
  let c: int = source_peek();
  if c == 0 then {
    tok_kind = L_EOF;
    tok_value = 0;
    return tok_kind;
  }
  if is_alpha(c) == 1 then {
    while is_alnum(source_peek()) == 1 {
      source_take();
    }
    tok_length = source_pos - tok_start;
    tok_kind = word_code(tok_start, tok_length);
    if tok_kind == L_ID || tok_kind == L_ARRAY then tok_value = sym_intern(tok_start, tok_length, tok_kind, 0);
    else tok_value = 0;
    return tok_kind;
  }
  if c == 39 then {
    source_take();
    let v: int = source_take();
    if v == 92 then { let e: int = source_take(); if e == 110 then v = 10; else if e == 116 then v = 9; else if e == 114 then v = 13; else if e == 98 then v = 8; else if e == 102 then v = 12; else if e == 118 then v = 11; else if e == 48 then v = 0; else v = e; }
    if source_peek() != 39 then { tok_kind = L_EOF; tok_value = 0; return tok_kind; }
    source_take();
    tok_kind = L_CHAR; tok_value = v; tok_length = 3; return tok_kind;
  }
  if c == 34 then {
    source_take();
    while source_peek() != 34 {
      if source_pos > source_len - 1 then {
        tok_kind = L_EOF;
        tok_value = 0;
        return tok_kind;
      }
      if source_peek() == 92 then {
        source_take();
        if source_peek() != 0 then source_take();
      } else source_take();
    }
    source_take();
    tok_kind = L_STRING;
    tok_length = source_pos - tok_start;
    tok_value = sym_intern(tok_start + 1, tok_length - 2, L_STRING, 0);
    return tok_kind;
  }
  if is_digit(c) == 1 then {
    let value: int = 0;
    while is_digit(source_peek()) == 1 {
      value = value * 10 + source_take() - 48;
    }
    if source_peek() == 46 then { source_take(); while is_digit(source_peek()) == 1 { source_take(); } tok_kind = L_FLOAT; tok_length = source_pos - tok_start; tok_value = sym_intern(tok_start, tok_length, L_FLOAT, 0); return tok_kind; }
    tok_kind = L_INT;
    tok_value = value;
    tok_length = source_pos - tok_start;
    return tok_kind;
  }
  source_take();
  tok_length = 1;
  if c == 43 then {
    if source_peek() == 43 then { source_take(); tok_kind = L_CONCAT; }
    else tok_kind = L_PLUS;
  }
  else if c == 45 then tok_kind = L_MINUS;
  else if c == 42 then tok_kind = L_STAR;
  else if c == 47 then tok_kind = L_DIV;
  else if c == 37 then tok_kind = L_MOD;
  else if c == 40 then tok_kind = L_LPAREN;
  else if c == 41 then tok_kind = L_RPAREN;
  else if c == 123 then tok_kind = L_LBRACE;
  else if c == 125 then tok_kind = L_RBRACE;
  else if c == 58 then { if source_peek() == 58 then { source_take(); tok_kind = L_SCOPE; } else tok_kind = L_COLON; }
  else if c == 59 then tok_kind = L_SEMI;
  else if c == 44 then tok_kind = L_COMMA;
  else if c == 91 then tok_kind = L_LBRACK;
  else if c == 93 then tok_kind = L_RBRACK;
  else if c == 46 then tok_kind = L_DOT;
  else if c == 60 then { if source_peek() == 60 then { source_take(); tok_kind = L_SHL; } else tok_kind = L_LT; }
  else if c == 62 then { if source_peek() == 62 then { source_take(); tok_kind = L_SHR; } else tok_kind = L_GT; }
  else if c == 124 then { if source_peek() == 124 then { source_take(); tok_kind = L_OR; } else tok_kind = L_BITOR; }
  else if c == 94 then tok_kind = L_BITXOR;
  else if c == 126 then tok_kind = L_BITNOT;
  else if c == 61 then {
    if source_peek() == 61 then { source_take(); tok_kind = L_EQEQ; }
    else tok_kind = L_EQ;
  }
  else if c == 33 then {
    if source_peek() == 61 then { source_take(); tok_kind = L_NEQ; }
    else tok_kind = L_NEQ;
  }
  else if c == 38 then {
    if source_peek() == 38 then { source_take(); tok_kind = L_AND; }
    else tok_kind = L_AMP;
  }
  else if c == 124 then {
    if source_peek() == 124 then { source_take(); tok_kind = L_OR; }
    else tok_kind = L_EOF;
  }
  else tok_kind = L_EOF;
  tok_value = 0;
  return tok_kind;
}

func include_process_line(line: int*, length: int): void {
  let mode: int = 0;
  let p: int = 0;
  while p < length && (line[p] == 32 || line[p] == 9) { p = p + 1; }
  if p + 7 < length then {
    if line[p] == 105 && line[p + 1] == 110 && line[p + 2] == 99 && line[p + 3] == 108 && line[p + 4] == 117 && line[p + 5] == 100 && line[p + 6] == 101 then {
      if line[p + 7] == 32 || line[p + 7] == 9 then mode = 1;
    }
  }
  if p + 8 < length && mode == 0 then {
    if line[p] == 105 && line[p + 1] == 110 && line[p + 2] == 99 && line[p + 3] == 108 && line[p + 4] == 117 && line[p + 5] == 100 && line[p + 6] == 101 && line[p + 7] == 99 then {
      if line[p + 8] == 32 || line[p + 8] == 9 then mode = 2;
    }
  }
  if mode == 0 then {
    let i: int = 0;
    while i < length { source_put(line[i]); i = i + 1; }
    source_put(10);
  } else {
    let child: int* = basalt_include_open_line(line, length, mode);
    if child == 0 then {
      if basalt_include_last_status() == 1 then include_ok = 0;
    } else {
      if mode == 1 then {
        include_expand_handle(child);
      } else {
        let c: int = read_char(child);
        while c != (0 - 1) { c_source_put(c); c = read_char(child); }
      }
      close_file(child);
      basalt_include_close();
    }
  }
}

func include_expand_handle(handle: int*): void {
  let line: int* = alloc_ints(include_line_cap);
  let length: int = 0;
  let c: int = read_char(handle);
  while c != (0 - 1) {
    if c == 10 then { include_process_line(line, length); length = 0; }
    else {
      if length < include_line_cap then { line[length] = c; length = length + 1; }
      else include_ok = 0;
    }
    c = read_char(handle);
  }
  if length > 0 then include_process_line(line, length);
  // `handle` is borrowed; the caller owns the root include handle.
}

func load_source_file(path: string): void {
  source_reset();
  let handle: int* = open_file(path, "r");
  let c: int = read_char(handle);
  while c != (0 - 1) {
    source_put(c);
    c = read_char(handle);
  }
  close_file(handle);
}


func map_token(k: int): int {
  if k == L_EOF then return T_EOF;
  if k == L_ID then return T_ID;
  if k == L_INT then return T_INT;
  if k == L_STRING then return T_STRING;
  if k == L_FUNC then return T_FUNC;
  if k == L_EXTERN then return T_EXTERN;
  if k == L_LET then return T_LET;
  if k == L_PRINT then return T_PRINT;
  if k == L_RETURN then return T_RETURN;
  if k == L_IF then return T_IF;
  if k == L_ELSE then return T_ELSE;
  if k == L_WHILE then return T_WHILE;
  if k == L_FOR then return T_FOR;
  if k == L_STRUCT then return T_STRUCT;
  if k == L_ENUM then return T_ENUM;
  if k == L_BREAK then return T_BREAK;
  if k == L_CONTINUE then return T_CONTINUE;
  if k == L_TRUE then return T_TRUE;
  if k == L_FALSE then return T_FALSE;
  if k == L_TINT then return T_TINT;
  if k == L_TBOOL then return T_TBOOL;
  if k == L_TSTRING then return T_TSTRING;
  if k == L_TVOID then return T_TVOID;
  if k == L_THEN then return T_THEN;
  if k == L_PLUS then return T_PLUS;
  if k == L_MINUS then return T_MINUS;
  if k == L_STAR then return T_STAR;
  if k == L_DIV then return T_DIVIDE;
  if k == L_MOD then return T_MOD;
  if k == L_CONCAT then return T_CONCAT;
  if k == L_AND then return T_AND_AND;
  if k == L_OR then return T_OR_OR;
  if k == L_EQ then return T_EQUAL;
  if k == L_EQEQ then return T_EQEQ;
  if k == L_NEQ then return T_NEQ;
  if k == L_LT then return T_LT;
  if k == L_GT then return T_GT;
  if k == L_COLON then return T_COLON;
  if k == L_LPAREN then return T_LPAREN;
  if k == L_RPAREN then return T_RPAREN;
  if k == L_LBRACE then return T_LBRACE;
  if k == L_RBRACE then return T_RBRACE;
  if k == L_SEMI then return T_SEMI;
  if k == L_COMMA then return T_COMMA;
  if k == L_AMP then return T_AMP;
  if k == L_LBRACK then return T_LBRACK;
  if k == L_RBRACK then return T_RBRACK;
  if k == L_DOT then return T_DOT;
  if k == L_CHAR then return T_CHAR;
  if k == L_NULL then return T_NULL;
  if k == L_CONST then return T_CONST;
  if k == L_TCHAR then return T_TCHAR;
  if k == L_FLOAT then return T_FLOAT;
  if k == L_TFLOAT then return T_FLOAT;
  if k == L_TDOUBLE then return T_TDOUBLE;
  if k == L_BITOR then return T_BITOR;
  if k == L_BITXOR then return T_BITXOR;
  if k == L_BITNOT then return T_BITNOT;
  if k == L_SHL then return T_SHL;
  if k == L_SHR then return T_SHR;
  if k == L_FN then return T_FN;
  if k == L_ARRAY then return T_ARRAY;
  if k == L_NAMESPACE then return T_NAMESPACE;
  if k == L_SCOPE then return T_SCOPE;
  return T_EOF;
}

func load_tokens_from_file(path: string): void {
  input_reset();
  basalt_include_reset_session();
  source_reset();
  sym_text_len = 0;
  sym_count = 1;
  ast_namespace_scope = 0;
  c_source_reset();
  include_ok = 1;
  let handle: int* = basalt_include_open_root(path);
  if handle == 0 then include_ok = 0;
  else {
    include_expand_handle(handle);
    close_file(handle);
    basalt_include_close();
  }
  let k: int = lexer_next();
  while k != L_EOF {
    if debug_tokens == 1 then {
      print map_token(k);
      print tok_start;
      print tok_length;
      print tok_value;
    }
    input_put(map_token(k), tok_value);
    k = lexer_next();
  }
  input_put(T_EOF, 0);
}

// Bootstrap type checker. Types are represented by (kind, named-id) pairs so
// recursive pointer types do not require eagerly laying out the pointed struct.
let tc_root: int = 0;
let tc_ok: int = 1;
let tc_error_code: int = 0;
let tc_error_symbol: int = 0;
let tc_error_pos: int = 0;
let tc_name: int = 0;
let tc_kind: int = 0;
let tc_elem_kind: int = 0;
let tc_elem_name: int = 0;
let tc_expected_elem_kind: int = 0;
let tc_expected_elem_name: int = 0;
let tc_var_name: int* = 0;
let tc_var_kind: int* = 0;
let tc_var_named: int* = 0;
let tc_var_elem_kind: int* = 0;
let tc_var_elem_name: int* = 0;
let tc_var_type: int* = 0;
let tc_var_owned: int* = 0;
let tc_var_moved: int* = 0;
let tc_var_borrow_count: int* = 0;
let tc_var_borrow_source: int* = 0;
let tc_last_var_type: int = 0;
let tc_last_var_owned: int = 0;
let tc_last_var_moved: int = 0;
let tc_last_var_index: int = 0;
let tc_expr_borrow_source: int = 0 - 1;
let tc_var_count: int = 0;
let tc_global_count: int = 0;
let tc_var_cap: int = 0;
let tc_scope_start: int* = 0;
let tc_scope_count: int = 0;
let tc_scope_cap: int = 0;
let tc_path_name: int* = 0;
let tc_path_count: int = 0;
let tc_path_cap: int = 0;
let tc_loop_depth: int = 0;
let tc_result_type: int = 0;
let tc_bind_name: int* = 0;
let tc_bind_type: int* = 0;
let tc_bind_count: int = 0;
let tc_bind_cap: int = 0;

func ensure_tc_vars(need: int): void {
  if need < tc_var_cap then return;
  let n: int = next_capacity(tc_var_cap, need);
  tc_var_name = grow_ints(tc_var_name, tc_var_cap, n);
  tc_var_kind = grow_ints(tc_var_kind, tc_var_cap, n);
  tc_var_named = grow_ints(tc_var_named, tc_var_cap, n);
  tc_var_elem_kind = grow_ints(tc_var_elem_kind, tc_var_cap, n);
  tc_var_elem_name = grow_ints(tc_var_elem_name, tc_var_cap, n);
  tc_var_type = grow_ints(tc_var_type, tc_var_cap, n);
  tc_var_owned = grow_ints(tc_var_owned, tc_var_cap, n);
  tc_var_moved = grow_ints(tc_var_moved, tc_var_cap, n);
  tc_var_borrow_count = grow_ints(tc_var_borrow_count, tc_var_cap, n);
  tc_var_borrow_source = grow_ints(tc_var_borrow_source, tc_var_cap, n);
  tc_var_cap = n;
}

func ensure_tc_scopes(need: int): void {
  if need < tc_scope_cap then return;
  let n: int = next_capacity(tc_scope_cap, need);
  tc_scope_start = grow_ints(tc_scope_start, tc_scope_cap, n);
  tc_scope_cap = n;
}

func tc_enter_scope(): void {
  ensure_tc_scopes(tc_scope_count);
  tc_scope_start[tc_scope_count] = tc_var_count;
  tc_scope_count = tc_scope_count + 1;
}

func tc_leave_scope(): void {
  let begin: int = 0;
  let i: int = 0;
  let source_index: int = 0;
  if tc_scope_count == 0 then return;
  tc_scope_count = tc_scope_count - 1;
  begin = tc_scope_start[tc_scope_count];
  i = begin;
  while i < tc_var_count {
    source_index = tc_var_borrow_source[i];
    if source_index < 0 then { } else if source_index < begin && tc_var_borrow_count[source_index] > 0 then tc_var_borrow_count[source_index] = tc_var_borrow_count[source_index] - 1;
    i = i + 1;
  }
  tc_var_count = begin;
}

func ensure_tc_path(need: int): void {
  if need < tc_path_cap then return;
  let n: int = next_capacity(tc_path_cap, need);
  tc_path_name = grow_ints(tc_path_name, tc_path_cap, n);
  tc_path_cap = n;
}

func tc_fail(code: int): void {
  if tc_ok == 1 then {
    tc_ok = 0;
    tc_error_code = code;
    tc_error_pos = current_source_pos;
  }
}

func ensure_tc_bindings(need: int): void {
  if need < tc_bind_cap then return;
  let n: int = next_capacity(tc_bind_cap, need);
  tc_bind_name = grow_ints(tc_bind_name, tc_bind_cap, n);
  tc_bind_type = grow_ints(tc_bind_type, tc_bind_cap, n);
  tc_bind_cap = n;
}

func tc_bind_clear(): void { tc_bind_count = 0; }

func tc_bind_find(name: int): int {
  let i: int = 0;
  while i < tc_bind_count { if tc_bind_name[i] == name then return tc_bind_type[i]; i = i + 1; }
  return 0;
}

func tc_bind_add(name: int, ty: int): int {
  let old: int = tc_bind_find(name);
  if old != 0 then {
    if tc_type_equal(old, ty) == 0 then { tc_fail(12); return 0; }
    return 1;
  }
  ensure_tc_bindings(tc_bind_count);
  tc_bind_name[tc_bind_count] = name;
  tc_bind_type[tc_bind_count] = ty;
  tc_bind_count = tc_bind_count + 1;
  return 1;
}

func tc_type_equal(a: int, b: int): int {
  if a == 0 || b == 0 then return 0;
  let ak: int = node_kind[a]; let bk: int = node_kind[b];
  if ak == TY_PARAM || bk == TY_PARAM then { if ak == bk && node_value[a] == node_value[b] then return 1; return 0; }
  if ak != bk then return 0;
