func tc_find_function(name: int): int {
  let item: int = node_a[tc_root];
  while item != 0 {
    if (node_kind[item] == N_FUNC || node_kind[item] == N_GENERIC_FUNC || node_kind[item] == N_EXTERN) && node_value[item] == name then return item;
    item = node_next[item];
  }
  return 0;
}

func tc_find_function_ctx(name: int, ns: int): int {
  let exact: int = tc_find_function(name);
  if exact != 0 then return exact;
  if ns == 0 then return 0;
  let item: int = node_a[tc_root];
  while item != 0 {
    if (node_kind[item] == N_FUNC || node_kind[item] == N_GENERIC_FUNC || node_kind[item] == N_EXTERN) && node_scope[item] == ns && sym_suffix_equal(node_value[item], name) == 1 then return item;
    item = node_next[item];
  }
  return 0;
}

func tc_find_enum_value(name: int): int {
  let item: int = node_a[tc_root];
  while item != 0 {
    if node_kind[item] == N_ENUM then {
      let f: int = node_a[item];
      while f != 0 { if node_a[f] == name then return node_value[item]; f = node_next[f]; }
    }
    item = node_next[item];
  }
  return 0;
}

func tc_emit_field_type(id: int): int {
  if id == 0 || node_kind[id] != N_FIELD_ACCESS then return 0;
  let base_ty: int = tc_emit_arg_type(node_a[id]);
  if base_ty == 0 then return 0;
  base_ty = gen_substitute_type(base_ty);
  let struct_name: int = 0;
  let args: int = 0;
  if node_kind[base_ty] == TY_GENERIC then { struct_name = node_value[base_ty]; args = node_a[base_ty]; }
  else if node_kind[base_ty] == TY_NAMED then struct_name = node_value[base_ty];
  else return 0;
  let decl: int = tc_find_struct(struct_name);
  if decl == 0 then return 0;
  if node_kind[decl] == N_GENERIC_STRUCT then {
    let gp: int = node_c[decl]; let ga: int = args;
    tc_bind_clear();
    while gp != 0 && ga != 0 { if tc_bind_add(node_a[gp], ga) == 0 then return 0; gp = node_next[gp]; ga = node_next[ga]; }
  }
  let f: int = node_a[decl];
  while f != 0 {
    if node_a[f] == node_value[id] then return gen_substitute_type(node_b[f]);
    f = node_next[f];
  }
  return 0;
}

func tc_emit_arg_type(id: int): int {
  if id == 0 then return 0;
  if node_kind[id] == N_FIELD_ACCESS then {
    let field_ty: int = tc_emit_field_type(id);
    if field_ty != 0 then return field_ty;
  }
  if node_kind[id] == N_VAR then {
    let formal_type: int = gen_active_param_type(node_value[id]);
    if formal_type != 0 then return gen_substitute_type(formal_type);
    if node_aux[id] != 0 then return node_aux[id];
  }
  if node_kind[id] == N_STRING then return ast_node(TY_STRING, 0, 0, 0, 0, 0);
  if node_kind[id] == N_INT then return ast_node(TY_INT, 0, 0, 0, 0, 0);
  if node_kind[id] == N_BOOL then return ast_node(TY_BOOL, 0, 0, 0, 0, 0);
  if node_kind[id] == N_CHAR then return ast_node(TY_CHAR, 0, 0, 0, 0, 0);
  if node_kind[id] == N_FLOAT then return ast_node(TY_DOUBLE, 0, 0, 0, 0, 0);
  if node_kind[id] == N_NULL then return ast_node(TY_PTR, ast_node(TY_VOID, 0, 0, 0, 0, 0), 0, 0, 0, 0);
  let ek: int = gen_expr_kind(id);
  return tc_type_node_from_summary(ek, 0, tc_elem_kind, tc_elem_name);
}

func tc_expr_kind_for_emit(id: int): int {
  if id != 0 && node_kind[id] == N_CALL && node_aux[id] != 0 then return node_kind[node_aux[id]];
  if id != 0 && node_kind[id] == N_INDIRECT_CALL then {
    tc_expr(id);
    return tc_kind;
  }
  let f: int = tc_find_function_ctx(node_value[id], node_scope[id]);
  if f != 0 then {
    if node_kind[f] == N_GENERIC_FUNC then {
      let actual: int = 0; let a: int = node_a[id];
      while a != 0 {
        let q: int = tc_emit_arg_type(a);
        if q != 0 then { if actual == 0 then actual = q; else actual = ast_link(actual, q); }
        a = node_next[a];
      }
      let saved_count: int = gen_bind_count;
      ensure_gen_bind(saved_count + saved_count);
      let save_i: int = 0;
      while save_i < saved_count {
        gen_bind_name[saved_count + save_i] = gen_bind_name[save_i];
        gen_bind_type[saved_count + save_i] = gen_bind_type[save_i];
        save_i = save_i + 1;
      }
      gen_bind_decl(f, actual);
      let ret: int = gen_substitute_type(node_b[f]);
      let result_kind: int = TY_INT;
      if ret != 0 then { result_kind = node_kind[ret]; }
      gen_bind_clear();
      let restore_i: int = 0;
      while restore_i < saved_count {
        gen_bind_name[restore_i] = gen_bind_name[saved_count + restore_i];
        gen_bind_type[restore_i] = gen_bind_type[saved_count + restore_i];
        restore_i = restore_i + 1;
      }
      gen_bind_count = saved_count;
      if result_kind == TY_PARAM then { return TY_INT; }
      return result_kind;
    }
    if node_b[f] != 0 then { return node_kind[node_b[f]]; }
  }
  return TY_INT;
}

func tc_stmt(id: int, expected_kind: int, expected_name: int): void {
  if id != 0 then tc_error_pos = node_pos[id];
  if tc_ok == 0 || id == 0 then return;
  let k: int = node_kind[id];
  if k == N_CONST then {
    tc_type_node(node_b[id]); let ck: int = tc_kind; let cn: int = tc_name; let ce: int = tc_elem_kind; let cen: int = tc_elem_name;
    tc_expr(node_c[id]); if tc_same_full(ck, cn, ce, cen, tc_kind, tc_name, tc_elem_kind, tc_elem_name) == 0 then { if node_kind[node_c[id]] != N_INT || node_value[node_c[id]] != 0 then if node_kind[node_c[id]] != N_NULL then tc_fail(30); }
    tc_add_var(node_a[id], ck, cn, ce, cen, node_b[id]); sym_type[node_a[id]] = ck + 100;
  } else   if k == N_LET then {
    tc_type_node(node_b[id]); let dk: int = tc_kind; let dn: int = tc_name; let de: int = tc_elem_kind; let den: int = tc_elem_name;
    tc_expr(node_c[id]); let ek: int = tc_kind; let en: int = tc_name; let ee: int = tc_elem_kind; let een: int = tc_elem_name; let rhs_borrow: int = tc_expr_borrow_source;
    if tc_is_owner_kind(dk) == 1 && node_kind[node_c[id]] == N_VAR then tc_fail(40);

    if tc_same_full(dk, dn, de, den, ek, en, ee, een) == 0 then {
      if (node_kind[node_c[id]] != N_INT || node_value[node_c[id]] != 0) && node_kind[node_c[id]] != N_NULL then tc_fail(20);
    }
    if dk == TY_DYN_ARRAY && node_kind[node_c[id]] == N_VAR then tc_move_value(node_c[id]);
    tc_add_var(node_a[id], dk, dn, de, den, node_b[id]);
    if dk == TY_DYN_ARRAY || tc_owned_initializer(node_c[id]) == 1 then tc_var_owned[tc_last_var_index] = 1;
    if dk == TY_PTR then { if rhs_borrow < 0 then { } else tc_record_borrow(tc_last_var_index, rhs_borrow); }
  } else if k == N_ASSIGN then {
    if node_kind[node_a[id]] == N_VAR && sym_type[node_value[node_a[id]]] > 100 then tc_fail(31);
    tc_expr(node_a[id]); let lk: int = tc_kind; let ln: int = tc_name; let le: int = tc_elem_kind; let len: int = tc_elem_name; let lhs_borrow: int = tc_expr_borrow_source; let lhs_index: int = tc_last_var_index;
    tc_require_mutable(node_a[id]);
    tc_expr(node_b[id]); let rhs_borrow_assign: int = tc_expr_borrow_source;
    if lk == TY_DYN_ARRAY && node_kind[node_b[id]] == N_VAR then tc_fail(40);
    if tc_same_full(lk, ln, le, len, tc_kind, tc_name, tc_elem_kind, tc_elem_name) == 0 then { if (node_kind[node_b[id]] != N_INT || node_value[node_b[id]] != 0) && node_kind[node_b[id]] != N_NULL then tc_fail(21); }
    if tc_ok == 1 && node_kind[node_a[id]] == N_VAR && lk == TY_DYN_ARRAY then {
      tc_var_owned[lhs_index] = 1;
      tc_var_moved[lhs_index] = 0;
    }
    if tc_ok == 1 && node_kind[node_a[id]] == N_VAR && lk == TY_PTR then {
      if lhs_borrow < 0 then { } else if lhs_borrow < tc_var_count && tc_var_borrow_count[lhs_borrow] > 0 then tc_var_borrow_count[lhs_borrow] = tc_var_borrow_count[lhs_borrow] - 1;
      tc_var_borrow_source[lhs_index] = 0 - 1;
      if rhs_borrow_assign < 0 then { } else tc_record_borrow(lhs_index, rhs_borrow_assign);
    }
  } else if k == N_PRINT then tc_expr(node_a[id]);
  else if k == N_EXPR then { tc_expr(node_a[id]); if node_kind[node_a[id]] == N_CALL then tc_consume_call(node_a[id]); }
  else if k == N_RETURN then {
    if node_a[id] == 0 then { if expected_kind != TY_VOID then tc_fail(22); }
    else { tc_expr(node_a[id]); let return_borrow: int = tc_expr_borrow_source; if expected_kind == TY_PTR then { if return_borrow < 0 then { } else tc_fail(38); } if tc_same_full(expected_kind, expected_name, tc_expected_elem_kind, tc_expected_elem_name, tc_kind, tc_name, tc_elem_kind, tc_elem_name) == 0 then if node_kind[node_a[id]] != N_NULL then tc_fail(23); }
  } else if k == N_BREAK || k == N_CONTINUE then { if tc_loop_depth == 0 then tc_fail(24);   } else if k == N_BLOCK then {
    tc_enter_scope();
    let x: int = node_a[id]; while x != 0 { tc_stmt(x, expected_kind, expected_name); x = node_next[x]; }
    tc_leave_scope();

  } else if k == N_IF then {
    tc_expr(node_a[id]); if tc_kind != TY_BOOL && tc_kind != TY_INT && tc_kind != TY_CHAR && tc_kind != TY_FLOAT && tc_kind != TY_DOUBLE && tc_kind != TY_PTR && tc_kind != TY_FUN then tc_fail(25);
    tc_stmt(node_b[id], expected_kind, expected_name); tc_stmt(node_c[id], expected_kind, expected_name);
  } else if k == N_WHILE then {
    tc_expr(node_a[id]); if tc_kind != TY_BOOL && tc_kind != TY_INT && tc_kind != TY_CHAR && tc_kind != TY_FLOAT && tc_kind != TY_DOUBLE && tc_kind != TY_PTR && tc_kind != TY_FUN then tc_fail(26);
    tc_loop_depth = tc_loop_depth + 1; tc_stmt(node_b[id], expected_kind, expected_name); tc_loop_depth = tc_loop_depth - 1;
  } else if k == N_FOR then {
    tc_enter_scope();
    if node_a[id] != 0 then tc_stmt(node_a[id], expected_kind, expected_name);
    tc_expr(node_b[id]); if tc_kind != TY_BOOL && tc_kind != TY_INT && tc_kind != TY_CHAR && tc_kind != TY_FLOAT && tc_kind != TY_DOUBLE && tc_kind != TY_PTR && tc_kind != TY_FUN then tc_fail(27);
    tc_loop_depth = tc_loop_depth + 1; tc_stmt(node_c[id], expected_kind, expected_name); tc_loop_depth = tc_loop_depth - 1;
    if node_value[id] != 0 then tc_stmt(node_value[id], expected_kind, expected_name);
    tc_leave_scope();
  }
}

func tc_diag_line(pos: int): int {
  let i: int = 0; let line: int = 1;
  while i < pos && i < source_len { if source[i] == 10 then line = line + 1; i = i + 1; }
  return line;
}
func tc_diag_col(pos: int): int {
  let i: int = 0; let col: int = 1;
  while i < pos && i < source_len { if source[i] == 10 then col = 1; else col = col + 1; i = i + 1; }
  return col;
}
func tc_diag(): void {
  if tc_error_code == 3 then print "type error: duplicate declaration";
  else if tc_error_code == 5 then print "type error: unknown name";
  else if tc_error_code == 12 then print "type error: invalid function arguments";
  else if tc_error_code == 14 then print "type error: string concatenation requires strings";
  else if tc_error_code == 18 then print "type error: invalid arithmetic operands";
  else if tc_error_code == 20 then print "type error: initializer type mismatch";
  else if tc_error_code == 21 then print "type error: assignment type mismatch";
  else if tc_error_code == 23 then print "type error: return type mismatch";
  else if tc_error_code == 28 then print "type error: recursive struct definition";
  else if tc_error_code == 31 then print "type error: assignment to const";
  else if tc_error_code == 33 then print "type error: use after ownership move";
  else if tc_error_code == 34 then print "type error: use after ownership move";
  else if tc_error_code == 35 then print "type error: release requires an owned value";
  else if tc_error_code == 36 then print "type error: array element type mismatch";
  else if tc_error_code == 37 then print "type error: cannot mutate or move while borrowed";
  else if tc_error_code == 38 then print "type error: borrowed reference escapes its owner";
  else if tc_error_code == 40 then print "type error: owned value copy requires an explicit move";
  else if tc_error_code == 41 then print "type error: unknown function";
  else if tc_error_code == 42 then print "type error: cannot call non-function value";
  else if tc_error_code == 43 then print "type error: function name is reserved by the C runtime";
  else if tc_error_code == 44 then print "type error: distinct functions collide after C mangling";
  else print "type error: invalid expression";
  print tc_diag_line(tc_error_pos);
  print tc_diag_col(tc_error_pos);
}
func tc_check_function_symbols(root: int): int {
  let a: int = node_a[root];
  while a != 0 {
    if node_kind[a] == N_FUNC || node_kind[a] == N_GENERIC_FUNC || node_kind[a] == N_EXTERN then {
      let b: int = node_next[a];
      while b != 0 {
        if (node_kind[b] == N_FUNC || node_kind[b] == N_GENERIC_FUNC || node_kind[b] == N_EXTERN) && node_value[a] != node_value[b] then {
          let ca: int = sym_c_symbol(node_value[a]);
          let cb: int = sym_c_symbol(node_value[b]);
          if ca == cb then { tc_error_code = 44; tc_error_pos = node_pos[b]; tc_ok = 0; return 0; }
        }
        b = node_next[b];
      }
    }
    a = node_next[a];
  }
  return 1;
}
func tc_reserved_function(name: int): int {
  if sym_len[name] == 6 && sym_hash[name] == 509536 then return 1;
  if sym_len[name] == 12 && sym_hash[name] == 334590 then return 1;
