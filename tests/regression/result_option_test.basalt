include "../../src/stdlib/option.basalt"
include "../../src/stdlib/error.basalt"
include "../../src/stdlib/result.basalt"

func safe_div_int(a: int, b: int): result::Result<int, int> {
  if b == 0 then { return result::err(0, error::invalid_argument); }
  return result::ok(a / b, error::success);
}

func main(): int {
  let ok: result::Result<int, int> = safe_div_int(20, 4);
  let bad: result::Result<int, int> = safe_div_int(20, 0);
  let some: option::Option<int> = option::some(7);
  let none: option::Option<int> = option::none(0);
  print result::is_ok(ok);
  print result::is_err(bad);
  print result::unwrap_or(ok, 99);
  print result::error_or(bad, 99);
  print option::is_some(some);
  print option::is_none(none);
  print option::unwrap_or(some, 99);
  print option::unwrap_or(none, 99);
  return 0;
}
