include "../../src/stdlib/string.basalt"
include "../../src/stdlib/slice.basalt"
include "../../src/stdlib/map.basalt"

func main(): int {
  let round: int = 0;
  while (round < 120) {
    let s: string = "Basalt";
    let k: int = 0;
    while (k < 24) {
      s = str::concat(s, "-x");
      k = k + 1;
    }
    if (str::byte_len(s) == 51) then {
      print 1;
    } else {
      print 0;
    }

    let slice: slice::Slice<int> = slice::with_capacity(1, 0);
    let i: int = 0;
    while (i < 32) {
      slice = slice::push(slice, round + i);
      i = i + 1;
    }
    print slice::get(slice, 31);
    print slice::get(slice, 32);
    slice = slice::free(slice);

    let map: map::HashMap<int, int> = map::with_capacity(2, 0, 0);
    let m: int = 0;
    while (m < 40) {
      map = map::put(map, round + m, m * 3);
      m = m + 1;
    }
    print map::get_or(map, round + 17, (0 - 1));
    print map::get_or(map, 99999, (0 - 1));
    map = map::free(map);
    round = round + 1;
  }
  return 0;
}
