include "../../src/stdlib/map.basalt"

func main(): int {
  let m: map::HashMap<int, int> = map::new(0, 0);
  m = map::put(m, 3, 42);
  print map::contains_key(m, 3);
  print map::get_or(m, 3, 7);
  m = map::remove(m, 3);
  print map::contains_key(m, 3);
  m = map::put(m, 8, 64);
  m = map::clear(m);
  print map::length(m);
  m = map::free(m);
  return 0;
}
