include "../../src/stdlib/array.basalt"

func add32(value: f32): f32 {
  return value + 0.5;
}

func add64(value: f64): f64 {
  return value + 0.5;
}

func main(): int {
  let a: f32 = 1.5;
  let b: f64 = 2.25;

  a += 2.0;
  a *= 2.0;
  b /= 2.0;
  b += 0.5;

  if a < 6.99 || a > 7.01 then return 1;
  if b < 1.62 || b > 1.63 then return 2;
  if add32(a) < 7.49 || add32(a) > 7.51 then return 3;
  if add64(b) < 2.12 || add64(b) > 2.13 then return 4;

  let zero32: f32 = 0.0;
  let values32: array::Array<f32> = array::new(1, zero32);
  values32 = array::push(values32, 3.5, zero32);
  if array::get(values32, 0) < 3.49 || array::get(values32, 0) > 3.51 then return 5;
  array::free(values32);

  let zero64: f64 = 0.0;
  let values64: array::Array<f64> = array::new(1, zero64);
  values64 = array::push(values64, 6.25, zero64);
  if array::get(values64, 0) < 6.24 || array::get(values64, 0) > 6.26 then return 6;
  array::free(values64);

  return 0;
}

