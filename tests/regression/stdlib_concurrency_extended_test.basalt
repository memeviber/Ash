include "../../src/stdlib/concurrency.basalt"

func mutex_worker(argument: void*): int {
  if argument == null then return 1;
  if concurrency::mutex_lock(argument) != 0 then return 2;
  if concurrency::mutex_unlock(argument) != 0 then return 3;
  return 0;
}

func cancellation_worker(argument: void*): int {
  if argument == null then return 2;
  if concurrency::cancelled(argument) == 1 then return 1;
  return 0;
}

func main(): int {
  let status: int = 0;
  let mutex: void* = concurrency::mutex_make();
  if mutex == null then return 1;
  if concurrency::mutex_lock(mutex) != 0 then status = 2;
  if concurrency::mutex_unlock(mutex) != 0 then status = 3;

  let thread: void* = concurrency::thread_spawn(&mutex_worker, mutex);
  if thread == null then status = 4;
  if concurrency::thread_join(thread) != 0 then status = 5;
  if concurrency::mutex_free(mutex) != 0 then status = 6;

  let token: void* = concurrency::cancel_make();
  if token == null then status = 7;
  if concurrency::cancelled(token) != 0 then status = 8;
  if concurrency::cancel_request(token) != 0 then status = 9;
  if concurrency::cancelled(token) != 1 then status = 10;
  if concurrency::cancel_request(token) != 0 then status = 11;
  let cancelled_thread: void* = concurrency::thread_spawn(&cancellation_worker, token);
  if cancelled_thread == null then status = 12;
  if concurrency::thread_join(cancelled_thread) != 1 then status = 13;
  concurrency::cancel_free(token);

  return status;
}
