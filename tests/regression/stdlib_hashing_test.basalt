include "../../src/stdlib/map.basalt"

func hash_int(value: int): int { return value * 3; }
func eq_int(a: int, b: int): bool { return a == b; }

func main(): int {
  let m: map::HashMap<int, double> = map::new_with_hasher(0, 0.0, &hash_int, &eq_int);
  let i: int = 0;
  while i < 20 {
    m = map::put(m, i, 0.5);
    i = i + 1;
  }
  if map::length(m) != 20 then return 10;
  if map::get_or(m, 0, (0.0 - 1.0)) != 0.5 then return 11;
  if map::get_or(m, 19, 0.0) != 0.5 then return 12;
  m = map::remove(m, 6);
  if map::contains_key(m, 6) then return 13;
  m = map::put(m, 26, 52.5);
  if map::get_or(m, 26, 0.0) != 52.5 then return 14;
  m = map::clear(m);
  if map::length(m) != 0 then return 15;
  m = map::free(m);
  return 0;
}
