include "../../src/stdlib/option.basalt"
include "../../src/stdlib/result.basalt"
include "../../src/stdlib/array.basalt"
include "../../src/stdlib/slice.basalt"
include "../../src/stdlib/map.basalt"
include "../../src/stdlib/string.basalt"
include "../../src/stdlib/string_builder.basalt"

func inc(value: int): int { return value + 1; }
func double_value(value: int): int { return value * 2; }
func positive(value: int): bool { return value > 0; }
func plus_error(value: int): int { return value + 1; }

func main(): int {
  let status: int = 0;

  let present: option::Option<int> = option::some(4);
  let absent: option::Option<int> = option::none(0);
  let mapped: option::Option<int> = option::map(present, &inc, 0);
  let kept: option::Option<int> = option::filter(mapped, &positive, 0);
  let chosen: option::Option<int> = option::or_else(absent, present);
  let chained: option::Option<int> = option::and_option(present, option::some(9), 0);
  if option::value_or(kept, 0) != 5 then status = 1;
  if option::map_or(absent, 11, &inc) != 11 then status = 2;
  if option::value_or(chosen, 0) != 4 then status = 3;
  if option::value_or(chained, 0) != 9 then status = 4;
  if option::contains(kept, 5) == false then status = 5;

  let ok_value: result::Result<int, int> = result::ok(6, 0);
  let err_value: result::Result<int, int> = result::err(0, 7);
  let mapped_ok: result::Result<int, int> = result::map(ok_value, &double_value, 0);
  let mapped_err: result::Result<int, int> = result::map(err_value, &double_value, 0);
  let mapped_error: result::Result<int, int> = result::map_error(mapped_err, &plus_error, 0);
  let and_ok: result::Result<int, int> = result::and_result(ok_value, mapped_ok, 0);
  let and_err: result::Result<int, int> = result::and_result(err_value, mapped_ok, 0);
  let or_ok: result::Result<int, int> = result::or_result(ok_value, err_value, 0);
  let or_err: result::Result<int, int> = result::or_result(err_value, ok_value, 0);
  if result::value_or(mapped_ok, 0) != 12 then status = 6;
  if result::is_err(mapped_err) == 0 then status = 7;
  if result::error_or(mapped_error, 0) != 8 then status = 8;
  if result::value_or(and_ok, 0) != 12 then status = 9;
  if result::error_or(and_err, 0) != 7 then status = 10;
  if result::value_or(or_ok, 0) != 6 then status = 11;
  if result::value_or(or_err, 0) != 6 then status = 12;
  if result::map_or(err_value, 99, &inc) != 99 then status = 13;
  if result::map_error_or(ok_value, 99, &plus_error) != 99 then status = 14;
  if result::contains(mapped_ok, 12) == false then status = 15;

  let a: array::Array<int> = array::new(1, 0);
  a = array::push(a, 1, 0);
  a = array::push(a, 2, 0);
  let doubled: array::Array<int> = array::map(a, &double_value, 0);
  let filtered: array::Array<int> = array::filter(doubled, &positive, 0);
  if array::len(filtered) != 2 then status = 16;
  if array::get_or(filtered, 1, 0) != 4 then status = 17;

  let s: slice::Slice<int> = slice::new(0);
  s = slice::push(s, 3);
  s = slice::push(s, 4);
  let s_doubled: slice::Slice<int> = slice::map(s, &double_value, 0);
  let s_filtered: slice::Slice<int> = slice::filter(s_doubled, &positive);
  if slice::len(s_filtered) != 2 then status = 18;
  if slice::get(s_filtered, 0) != 6 then status = 19;

  let m: map::HashMap<int, int> = map::new(0, 0);
  m = map::put(m, 5, 50);
  if map::len(m) != 1 then status = 20;
  if map::get(m, 5) != 50 then status = 21;
  if map::is_empty(m) then status = 22;
  if map::contains_key(m, 7) then status = 23;

  let text: string = "Basalt";
  if str::len(text) != 6 then status = 24;
  if str::equals(text, "Basalt") == false then status = 25;

  let builder: string_builder::Builder = string_builder::new();
  if string_builder::is_empty(builder) == false then status = 26;
  builder = string_builder::append(builder, "ok");
  if string_builder::len(builder) != 2 then status = 27;

  builder = string_builder::free(builder);
  m = map::free(m);
  s_filtered = slice::free(s_filtered);
  s_doubled = slice::free(s_doubled);
  s = slice::free(s);
  filtered = array::free(filtered);
  doubled = array::free(doubled);
  a = array::free(a);
  return status;
}
// diagnostic: valid
// end
