    tc_add_var(node_a[id], ck, cn, ce, cen, node_b[id]); sym_type[node_a[id]] = ck + 100;
  } else if k == N_LET then {
    tc_type_node(node_b[id]); let dk: int = tc_kind; let dn: int = tc_name; let de: int = tc_elem_kind; let den: int = tc_elem_name;
    tc_expr(node_c[id]); let ek: int = tc_kind; let en: int = tc_name; let ee: int = tc_elem_kind; let een: int = tc_elem_name;
    if tc_same_full(dk, dn, de, den, ek, en, ee, een) == 0 then { if (node_kind[node_c[id]] != N_INT || node_value[node_c[id]] != 0) && node_kind[node_c[id]] != N_NULL then tc_fail(20); }
    tc_add_var(node_a[id], dk, dn, de, den, node_b[id]);
    if tc_owned_initializer(node_c[id]) == 1 then tc_var_owned[tc_last_var_index] = 1;
  } else if k == N_ASSIGN then {
    if node_kind[node_a[id]] == N_VAR && sym_type[node_value[node_a[id]]] > 100 then tc_fail(31);
    tc_expr(node_a[id]); let lk: int = tc_kind; let ln: int = tc_name; let le: int = tc_elem_kind; let len: int = tc_elem_name;
    tc_expr(node_b[id]); if tc_same_full(lk, ln, le, len, tc_kind, tc_name, tc_elem_kind, tc_elem_name) == 0 then { if (node_kind[node_b[id]] != N_INT || node_value[node_b[id]] != 0) && node_kind[node_b[id]] != N_NULL then tc_fail(21); }
  } else if k == N_PRINT then tc_expr(node_a[id]);
  else if k == N_EXPR then { tc_expr(node_a[id]); if node_kind[node_a[id]] == N_CALL then tc_consume_call(node_a[id]); }
  else if k == N_RETURN then {
    if node_a[id] == 0 then { if expected_kind != TY_VOID then tc_fail(22); }
    else { tc_expr(node_a[id]); if tc_same_full(expected_kind, expected_name, tc_expected_elem_kind, tc_expected_elem_name, tc_kind, tc_name, tc_elem_kind, tc_elem_name) == 0 then if node_kind[node_a[id]] != N_NULL then tc_fail(23); }
  } else if k == N_BREAK || k == N_CONTINUE then { if tc_loop_depth == 0 then tc_fail(24);   } else if k == N_BLOCK then {
    tc_enter_scope();
    let x: int = node_a[id]; while x != 0 { tc_stmt(x, expected_kind, expected_name); x = node_next[x]; }
    tc_leave_scope();

  } else if k == N_IF then {
    tc_expr(node_a[id]); if tc_kind != TY_BOOL && tc_kind != TY_INT && tc_kind != TY_CHAR && tc_kind != TY_FLOAT && tc_kind != TY_DOUBLE && tc_kind != TY_PTR && tc_kind != TY_FUN then tc_fail(25);
    tc_stmt(node_b[id], expected_kind, expected_name); tc_stmt(node_c[id], expected_kind, expected_name);
  } else if k == N_WHILE then {
    tc_expr(node_a[id]); if tc_kind != TY_BOOL && tc_kind != TY_INT && tc_kind != TY_CHAR && tc_kind != TY_FLOAT && tc_kind != TY_DOUBLE && tc_kind != TY_PTR && tc_kind != TY_FUN then tc_fail(26);
    tc_loop_depth = tc_loop_depth + 1; tc_stmt(node_b[id], expected_kind, expected_name); tc_loop_depth = tc_loop_depth - 1;
  } else if k == N_FOR then {
    tc_enter_scope();
    if node_a[id] != 0 then tc_stmt(node_a[id], expected_kind, expected_name);
    tc_expr(node_b[id]); if tc_kind != TY_BOOL && tc_kind != TY_INT && tc_kind != TY_CHAR && tc_kind != TY_FLOAT && tc_kind != TY_DOUBLE && tc_kind != TY_PTR && tc_kind != TY_FUN then tc_fail(27);
    tc_loop_depth = tc_loop_depth + 1; tc_stmt(node_c[id], expected_kind, expected_name); tc_loop_depth = tc_loop_depth - 1;
    if node_value[id] != 0 then tc_stmt(node_value[id], expected_kind, expected_name);
    tc_leave_scope();
  }
}

func tc_diag_line(pos: int): int {
  let i: int = 0; let line: int = 1;
  while i < pos && i < source_len { if source[i] == 10 then line = line + 1; i = i + 1; }
  return line;
}
func tc_diag_col(pos: int): int {
  let i: int = 0; let col: int = 1;
  while i < pos && i < source_len { if source[i] == 10 then col = 1; else col = col + 1; i = i + 1; }
  return col;
}
func tc_diag(): void {
  print 4999; print tc_error_code;
  if tc_error_code == 3 then print "type error: duplicate declaration";
  else if tc_error_code == 5 then print "type error: unknown name";
  else if tc_error_code == 12 then print "type error: invalid function arguments";
  else if tc_error_code == 14 then print "type error: string concatenation requires strings";
  else if tc_error_code == 18 then print "type error: invalid arithmetic operands";
  else if tc_error_code == 20 then print "type error: initializer type mismatch";
  else if tc_error_code == 21 then print "type error: assignment type mismatch";
  else if tc_error_code == 23 then print "type error: return type mismatch";
  else if tc_error_code == 28 then print "type error: recursive struct definition";
  else if tc_error_code == 31 then print "type error: assignment to const";
  else if tc_error_code == 34 then print "type error: use after ownership move";
  else if tc_error_code == 35 then print "type error: release requires an owned value";
  else print "type error: invalid expression";
  print tc_diag_line(tc_error_pos);
  print tc_diag_col(tc_error_pos);
}
func tc_program(root: int): int {
  tc_root = root; tc_ok = 1; tc_error_code = 0; tc_var_count = 0; tc_scope_count = 0; tc_path_count = 0; tc_loop_depth = 0;
  tc_enter_scope();
  let item: int = node_a[root];
  while item != 0 { if node_kind[item] == N_STRUCT then { let f: int = node_a[item]; while f != 0 { tc_check_type(node_b[f]); f = node_next[f]; } if tc_cycle_struct(node_value[item]) == 1 then tc_fail(28); } item = node_next[item]; }
  item = node_a[root];
    while item != 0 { if node_kind[item] == N_GLOBAL || node_kind[item] == N_CONST then { tc_type_node(node_b[item]); let gk: int = tc_kind; let gn: int = tc_name; let ge: int = tc_elem_kind; let gen: int = tc_elem_name; tc_add_var(node_a[item], gk, gn, ge, gen, node_b[item]); if node_kind[item] == N_CONST then sym_type[node_a[item]] = gk + 100; tc_expr(node_c[item]); if tc_same_full(gk, gn, ge, gen, tc_kind, tc_name, tc_elem_kind, tc_elem_name) == 0 then { if (node_kind[node_c[item]] != N_INT || node_value[node_c[item]] != 0) && node_kind[node_c[item]] != N_NULL then tc_fail(29); } } item = node_next[item]; }
    tc_global_count = tc_var_count;
  item = node_a[root];
    while item != 0 { if node_kind[item] == N_FUNC then { tc_var_count = tc_global_count; tc_scope_count = 1; tc_enter_scope(); let p: int = node_c[item];
  while p != 0 { tc_type_node(node_b[p]); tc_add_var(node_a[p], tc_kind, tc_name, tc_elem_kind, tc_elem_name, node_b[p]); p = node_next[p]; } tc_type_node(node_b[item]); tc_expected_elem_kind = tc_elem_kind; tc_expected_elem_name = tc_elem_name; tc_stmt(node_a[item], tc_kind, tc_name); tc_leave_scope(); } item = node_next[item]; }

  if tc_ok == 0 then { tc_diag(); return 0; }
  return 1;
}

func pipeline_main(path: string): int {
  load_tokens_from_file(path);
  node_count = 1;
    let root: int = ast_program();
  pipeline_root = root;
  let parsed: int = 1;
  if root < 0 then parsed = 0;
  if input_peek() != T_EOF then parsed = 0;
  if include_ok == 0 then parsed = 0;
  if parsed == 1 then {
    if tc_program(root) == 0 then parsed = 0;
  }
  if parsed == 1 then {
    code_reset();
    gen_program(root);
    let first: int = code_count;
    code_reset();
    gen_program(root);
    if code_count != first then parsed = 0;
  }
  if parsed == 0 then {
    if tc_error_code == 0 then {
      print "parse error";
      print tc_diag_line(source_pos);
      print tc_diag_col(source_pos);
    }
  }
  if parsed == 1 then { print 1; return 1; } else { print 0; return 0; }
}

func emit_symbol(out: int*, id: int): void {
  let i: int = 0;
  while i < sym_len[id] {
    write_char(out, source[sym_start[id] + i]);
    i = i + 1;
  }
}

func emit_string(out: int*, id: int): void {
  write_char(out, 34);
  emit_symbol(out, id);
  write_char(out, 34);
}

func emit_print_prefix(out: int*): void {
  write_string(out, "(");
  write_char(out, 34);
  write_string(out, "%d");
  write_char(out, 92);
  write_char(out, 110);
  write_char(out, 34);
  write_string(out, ", ");
}

func emit_int_text(out: int*, value: int): void {
  if value < 0 then {
    write_char(out, 45);
    emit_int_text(out, 0 - value);
  } else if value < 10 then {
    write_char(out, 48 + value);
  } else {
    emit_int_text(out, value / 10);
    write_char(out, 48 + (value - (value / 10) * 10));
  }
}

func emit_c_token(out: int*, kind: int, value: int): void {
  if kind == C_KW then {
    if value == 1 then write_string(out, "int ");
    else if value == 2 then write_string(out, "int ");
    else if value == 3 then write_string(out, "char* ");
    else if value == 4 then write_string(out, "void ");
    else if value == 5 then write_string(out, "return ");
    else if value == 6 then write_string(out, "if ");
    else if value == 7 then write_string(out, "else ");
    else if value == 8 then write_string(out, "while ");
    else if value == 9 then write_string(out, "break ");
    else if value == 10 then write_string(out, "continue ");
    else if value == 11 then write_string(out, "for ");
    else if value == 12 then write_string(out, "struct ");
    else if value == 13 then write_string(out, "enum ");
    else if value == 14 then write_string(out, "typedef ");
    else if value == 15 then write_string(out, "double ");
    else if value == 16 then write_string(out, "const ");
  } else if kind == C_IDENT then {
    if value == 1001 then write_string(out, "printf");
    else if value == 1002 then write_string(out, "string_concat");
    else emit_symbol(out, value);
  } else if kind == C_INT then emit_int_text(out, value);
  else if kind == C_STRING then emit_string(out, value);
  else if kind == C_OP then {
    if value == 1 then write_string(out, "+");
    else if value == 2 then write_string(out, "-");
    else if value == 3 then write_string(out, "*");
    else if value == 4 then write_string(out, "/");
    else if value == 5 then write_string(out, "==");
    else if value == 6 then write_string(out, "!=");
    else if value == 7 then write_string(out, "<");
    else if value == 8 then write_string(out, ">");
    else if value == 9 then write_string(out, "&&");
    else if value == 10 then write_string(out, "||");
    else if value == 11 then write_string(out, "++");
    else if value == 12 then write_string(out, "&");
    else if value == 13 then write_string(out, "|");
    else if value == 14 then write_string(out, "^");
    else if value == 15 then write_string(out, "<<");
    else if value == 16 then write_string(out, ">>");
  } else if kind == C_PUNCT then {
    if value == 1 then write_string(out, "*");
    else if value == 2 then write_string(out, "[");
    else if value == 3 then write_string(out, "]");
    else if value == 4 then write_string(out, "(");
    else if value == 5 then write_string(out, ")");
    else if value == 6 then write_string(out, "(");
    else if value == 7 then write_string(out, ", ");
    else if value == 8 then write_string(out, ")");
    else if value == 9 then write_string(out, "*");
    else if value == 10 then write_string(out, "&");
    else if value == 11 then write_string(out, " = ");
    else if value == 12 then write_string(out, ";");
    else if value == 13 then write_string(out, "{\n");
    else if value == 14 then write_string(out, "}\n");
    else if value == 15 then emit_print_prefix(out);
    else if value == 16 then {
      write_char(out, 40);
      write_char(out, 34);
      write_string(out, "%s");
      write_char(out, 92);
      write_char(out, 110);
      write_char(out, 34);
      write_string(out, ", ");
    } else if value == 17 then write_string(out, ".");
    else if value == 20 then { write_char(out, 40); write_char(out, 34); write_string(out, "%c"); write_char(out, 92); write_char(out, 110); write_char(out, 34); write_string(out, ", "); }
    else if value == 21 then { write_char(out, 40); write_char(out, 34); write_string(out, "%g"); write_char(out, 92); write_char(out, 110); write_char(out, 34); write_string(out, ", "); }
    else if value == 18 then write_string(out, " ");
    else if value == 19 then write_string(out, "{0}");
    else if value == 22 then write_char(out, 32);
  } else if kind == C_NEWLINE then write_char(out, 10);
}

func emit_runtime(out: int*): void {
  write_string(out, "#if defined(_WIN32)\n#include <direct.h>\n#else\n#define _POSIX_C_SOURCE 200809L\n#define _XOPEN_SOURCE 700\n#endif\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <limits.h>\nstatic void* pyrel_track(void*);\n");
  write_string(out, "static char** pyrel_inc_active=NULL;static size_t pyrel_inc_active_n=0,pyrel_inc_active_cap=0;static char** pyrel_inc_loaded=NULL;static size_t pyrel_inc_loaded_n=0,pyrel_inc_loaded_cap=0;static int pyrel_inc_status=0;\n");
  write_string(out, "static int pyrel_inc_eq(const char*a,const char*b){return strcmp(a,b)==0;}\n");
  write_string(out, "static size_t pyrel_inc_find(char**v,size_t n,const char*p){size_t i;for(i=0;i<n;i++)if(pyrel_inc_eq(v[i],p))return i;return (size_t)-1;}\n");
  write_string(out, "static void pyrel_inc_add(char***vp,size_t*np,size_t*cp,char*p){size_t c;char**q;if(*np==*cp){c=*cp?*cp*2:16;q=(char**)realloc(*vp,c*sizeof(char*));if(!q)exit(2);*vp=q;*cp=c;}(*vp)[(*np)++]=p;}\n");
  write_string(out, "static char* pyrel_inc_strdup(const char*p){size_t n=strlen(p);char*q=(char*)malloc(n+1);if(!q)exit(2);memcpy(q,p,n+1);return(char*)pyrel_track(q);}\n");
  write_string(out, "static char* pyrel_inc_realpath(const char*p){\n#if defined(_WIN32)\nchar*q=_fullpath(NULL,p,0);if(q)return(char*)pyrel_track(q);\n#else\nchar*q=realpath(p,NULL);if(q)return(char*)pyrel_track(q);\n#endif\nreturn pyrel_inc_strdup(p);}\n");
  write_string(out, "static int pyrel_inc_begin(char*p){if(pyrel_inc_find(pyrel_inc_active,pyrel_inc_active_n,p)!=(size_t)-1){pyrel_inc_status=1;return 0;}if(pyrel_inc_find(pyrel_inc_loaded,pyrel_inc_loaded_n,p)!=(size_t)-1){pyrel_inc_status=2;return 0;}pyrel_inc_add(&pyrel_inc_active,&pyrel_inc_active_n,&pyrel_inc_active_cap,p);pyrel_inc_status=0;return 1;}\n");
  write_string(out, "static void pyrel_include_close(void){if(pyrel_inc_active_n){char*p=pyrel_inc_active[--pyrel_inc_active_n];if(pyrel_inc_find(pyrel_inc_loaded,pyrel_inc_loaded_n,p)==(size_t)-1)pyrel_inc_add(&pyrel_inc_loaded,&pyrel_inc_loaded_n,&pyrel_inc_loaded_cap,p);}}\n");
  write_string(out, "static char* pyrel_inc_join(const char*base,const char*raw){const char*s=strrchr(base,'/');size_t n=s?(size_t)(s-base+1):0;size_t m=strlen(raw);char*q=(char*)malloc(n+m+1);if(!q)exit(2);if(n)memcpy(q,base,n);memcpy(q+n,raw,m+1);return(char*)pyrel_track(q);}\n");
  write_string(out, "static int pyrel_include_line_mode(int*line,int n){int i=0,j;while(i<n&&(line[i]==' '||line[i]==9))i++;if(i+7<=n&&line[i]=='i'&&line[i+1]=='n'&&line[i+2]=='c'&&line[i+3]=='l'&&line[i+4]=='u'&&line[i+5]=='d'&&line[i+6]=='e'){j=i+7;while(j<n&&(line[j]==' '||line[j]==9))j++;if(j<n&&line[j]==34)return 1;}if(i+8<=n&&line[i]=='i'&&line[i+1]=='n'&&line[i+2]=='c'&&line[i+3]=='l'&&line[i+4]=='u'&&line[i+5]=='d'&&line[i+6]=='e'&&line[i+7]=='c'){j=i+8;while(j<n&&(line[j]==' '||line[j]==9))j++;if(j<n&&line[j]==34)return 2;}return 0;}\n");
  write_string(out, "static void* pyrel_include_open_root(const char*path){char*p=pyrel_inc_realpath(path);FILE*f;if(!pyrel_inc_begin(p))return NULL;f=fopen(p,(const char[]){114,0});if(!f){pyrel_inc_status=3;pyrel_include_close();return NULL;}return(void*)f;}\n");
  write_string(out, "static void* pyrel_include_open_line(int*line,int n,int mode){int i=0,a,b,j;char*raw,*joined,*canon;FILE*f;(void)mode;while(i<n&&line[i]!=34)i++;if(i>=n)return NULL;a=++i;while(i<n&&line[i]!=34)i++;if(i>=n)return NULL;b=i;raw=(char*)malloc((size_t)(b-a)+1);if(!raw)exit(2);{int k;for(k=0;k<b-a;k++)raw[k]=(char)line[a+k];}raw[b-a]=0;raw=(char*)pyrel_track(raw);j=i+1;while(j<n&&(line[j]==32||line[j]==9))j++;if(j<n&&line[j]==59)j++;while(j<n&&(line[j]==32||line[j]==9))j++;if(j!=n)return NULL;joined=pyrel_inc_join(pyrel_inc_active[pyrel_inc_active_n-1],raw);canon=pyrel_inc_realpath(joined);if(!pyrel_inc_begin(canon))return NULL;f=fopen(canon,(const char[]){114,0});if(!f){pyrel_inc_status=3;pyrel_include_close();return NULL;}return(void*)f;}\n");
  write_string(out, "static int pyrel_include_last_status(void){return pyrel_inc_status;}\n");
  write_string(out, "static void pyrel_include_reset_session(void){pyrel_inc_active_n=0;pyrel_inc_loaded_n=0;pyrel_inc_status=0;}\n");
  write_string(out, "static void* open_file(const char* p,const char* m){return (void*)fopen(p,m);}\n");
  write_string(out, "static int read_char(void* h){int c=fgetc((FILE*)h);return c==EOF?-1:c;}\n");
  write_string(out, "static int close_file(void* h){return fclose((FILE*)h);}\n");
  write_string(out, "static int write_char(void* h,int c){return fputc(c,(FILE*)h);}\n");
  write_string(out, "static int write_string(void* h,const char* s){return fputs(s,(FILE*)h);}\n");
  write_string(out, "static void** pyrel_live=NULL;static size_t pyrel_live_n=0,pyrel_live_cap=0;\n");
  write_string(out, "static size_t pyrel_find(void* p){size_t i;for(i=0;i<pyrel_live_n;i++)if(pyrel_live[i]==p)return i;return (size_t)-1;}\n");
  write_string(out, "static void pyrel_validate(void){size_t i,j;for(i=0;i<pyrel_live_n;i++){if(!pyrel_live[i])abort();for(j=i+1;j<pyrel_live_n;j++)if(pyrel_live[i]==pyrel_live[j])abort();}}\n");
  write_string(out, "static void pyrel_cleanup(void){size_t i;pyrel_validate();for(i=0;i<pyrel_live_n;i++)free(pyrel_live[i]);free(pyrel_live);pyrel_live=NULL;pyrel_live_n=pyrel_live_cap=0;}\n");
  write_string(out, "static void* pyrel_track(void* p){size_t c;void**q;if(!p)return NULL;if(pyrel_find(p)!=(size_t)-1)abort();if(pyrel_live_n==pyrel_live_cap){c=pyrel_live_cap?pyrel_live_cap*2:32;q=(void**)realloc(pyrel_live,c*sizeof(void*));if(!q)exit(2);pyrel_live=q;pyrel_live_cap=c;}pyrel_live[pyrel_live_n++]=p;atexit(pyrel_cleanup);return p;}\n");
  write_string(out, "static void pyrel_release(void* p){size_t i;if(!p)return;i=pyrel_find(p);if(i==(size_t)-1)return;free(p);pyrel_live[i]=pyrel_live[--pyrel_live_n];}\n");
  write_string(out, "static char* string_concat(const char* a,const char* b){size_t na=strlen(a),nb=strlen(b);char* p=(char*)malloc(na+nb+1);if(!p)exit(2);memcpy(p,a,na);memcpy(p+na,b,nb);p[na+nb]=0;return (char*)pyrel_track(p);}\n");
  write_string(out, "static int* alloc_ints(int n){if(n<1)n=1;return (int*)pyrel_track(calloc((size_t)n,sizeof(int)));}\n");
  write_string(out, "static void free_ints(int* p){pyrel_release(p);}\n");
  write_string(out, "static int* grow_ints(int* p,int old,int n){size_t slot=(size_t)-1;int* q;if(n<=old)return p;if(p){slot=pyrel_find(p);if(slot==(size_t)-1)exit(2);}q=(int*)realloc(p,(size_t)n*sizeof(int));if(!q)exit(2);if(p)pyrel_live[slot]=q;else pyrel_track(q);return q;}\n");
  write_string(out, "extern int* payload_int; extern int* payload_name; extern int* payload_string;\n");
  write_string(out, "extern int* code_kind; extern int* code_value; extern int* input_kind; extern int* input_value;\n");
  write_string(out, "extern int* source; extern int* sym_start; extern int* sym_len; extern int* sym_hash; extern int* sym_kind; extern int* sym_type; extern int* sym_scope;\n\n");
}

func emit_c_file(path: string): void {
  let out: int* = open_file(path, "w");
  emit_runtime(out);
  let ci: int = 0;
  while ci < c_source_len { write_char(out, c_source[ci]); ci = ci + 1; }
  let i: int = 0;
  while i < code_count {
    emit_c_token(out, code_kind[i], code_value[i]);
    i = i + 1;
  }
  close_file(out);
}

func main(argc: int, argv: string*): void {
  if argc < 2 then {
    print 0;
    return 0;
  }
  let ok: int = pipeline_main(argv[1]);
  if argc > 2 && ok == 1 then {
    if pipeline_root > 0 then {
      gen_program(pipeline_root);
      emit_c_file(argv[2]);
    }
  }
}
