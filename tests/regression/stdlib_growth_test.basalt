include "../../src/stdlib/array.basalt"
include "../../src/stdlib/slice.basalt"
include "../../src/stdlib/map.basalt"

func main(): int {
  let status: int = 0;
  let i: int = 0;

  let ints: array::Array<int> = array::new(1, 0);
  while i < 40 {
    ints = array::push(ints, i, 0);
    i = i + 1;
  }
  if array::length(ints) != 40 then status = 1;
  if array::capacity(ints) < 40 then status = 2;
  if array::get(ints, 39) != 39 then status = 3;
  ints = array::set(ints, 17, 170);
  if array::get_or(ints, 17, 0) != 170 then status = 4;

  let flags: array::Array<bool> = array::new(1, false);
  i = 0;
  while i < 24 {
    flags = array::push(flags, (i % 2) == 0, false);
    i = i + 1;
  }
  if array::length(flags) != 24 then status = 5;
  if array::get(flags, 22) == false then status = 6;

  let letters: array::Array<char> = array::new(1, 'x');
  letters = array::push(letters, 'a', 'x');
  letters = array::push(letters, 'b', 'x');
  letters = array::push(letters, 'c', 'x');
  letters = array::push(letters, 'd', 'x');
  letters = array::push(letters, 'e', 'x');
  if array::length(letters) != 5 then status = 7;
  if array::get(letters, 4) != 'e' then status = 8;

  let decimals: array::Array<double> = array::new(1, 0.0);
  decimals = array::push(decimals, 1.25, 0.0);
  decimals = array::push(decimals, 2.5, 0.0);
  decimals = array::push(decimals, 5.0, 0.0);
  if array::length(decimals) != 3 then status = 9;
  if array::get(decimals, 2) != 5.0 then status = 10;

  let chars: slice::Slice<char> = slice::new('0');
  i = 0;
  while i < 36 {
    if i == 0 then chars = slice::push(chars, 'a');
    else if i == 1 then chars = slice::push(chars, 'b');
    else if i == 2 then chars = slice::push(chars, 'c');
    else chars = slice::push(chars, 'z');
    i = i + 1;
  }
  if slice::length(chars) != 36 then status = 11;
  if slice::capacity(chars) < 36 then status = 12;
  if slice::get(chars, 1) != 'b' then status = 13;
  chars = slice::set(chars, 35, 'y');
  if slice::last_or(chars, '0') != 'y' then status = 14;

  let decimals_slice: slice::Slice<double> = slice::new(0.0);
  i = 0;
  while i < 20 {
    decimals_slice = slice::push(decimals_slice, 0.5);
    i = i + 1;
  }
  if slice::length(decimals_slice) != 20 then status = 15;
  if slice::get(decimals_slice, 19) != 0.5 then status = 16;

  let numbers: map::HashMap<int, double> = map::new(0, 0.0);
  i = 0;
  while i < 48 {
    numbers = map::put(numbers, i, 1.5);
    i = i + 1;
  }
  if map::length(numbers) != 48 then status = 17;
  if map::capacity(numbers) < 48 then status = 18;
  if map::get_or(numbers, 47, 0.0) != 1.5 then status = 19;
  numbers = map::put(numbers, 17, 17.5);
  if map::get_or(numbers, 17, 0.0) != 17.5 then status = 20;
  numbers = map::remove(numbers, 17);
  if map::contains_key(numbers, 17) then status = 21;
  if map::length(numbers) != 47 then status = 22;

  let bool_map: map::HashMap<char, bool> = map::new('?', false);
  bool_map = map::put(bool_map, 'a', true);
  bool_map = map::put(bool_map, 'b', false);
  if map::get_or(bool_map, 'a', false) == false then status = 23;
  if map::contains_key(bool_map, 'b') == false then status = 24;

  ints = array::free(ints);
  flags = array::free(flags);
  letters = array::free(letters);
  decimals = array::free(decimals);
  chars = slice::free(chars);
  decimals_slice = slice::free(decimals_slice);
  numbers = map::free(numbers);
  bool_map = map::free(bool_map);
  return status;
}
