include "../../../src/stdlib/string.basalt"
func main(): int {
  let text: string = "héllo";
  if str::utf8_validate(text) == false then return 1;
  if str::byte_len(text) != 6 then return 2;
  if str::codepoint_len(text) != 5 then return 3;
  let joined: string = str::concat(text, "!");
  if str::byte_len(joined) != 7 then return 4;
  return 0;
}
