include "../../../src/stdlib/slice.pyrel"
func main(): int {
  let values: slice::Slice<char> = slice::new('!');
  let j: int = 0;
  while j < 21 {
    values = slice::push(values, 's');
    j = j + 1;
  }
  if slice::length(values) != 21 then return 1;
  if slice::capacity(values) < 21 then return 2;
  if slice::is_empty(values) then return 3;
  values = slice::set(values, 9, 's');
  values = slice::free(values);
  return 0;
}
