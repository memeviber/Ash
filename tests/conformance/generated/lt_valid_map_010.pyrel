include "../../../src/stdlib/map.pyrel"
func main(): int {
  let m: map::HashMap<double, char> = map::new(0.0, '?');
  m = map::put(m, 6.5, 'm');
  if map::length(m) != 1 then return 1;
  if map::contains_key(m, 6.5) == false then return 2;
  m = map::remove(m, 6.5);
  if map::length(m) != 0 then return 3;
  m = map::free(m);
  return 0;
}
