func increment(value: int): int {
  return value + 1;
}

func main(): int {
  let limit: int = 4;
  let value: int = 2;
  value += increment(1);
  if value != limit then {
    return 11;
  }
  if value == 4 then {
    let shadow: int = 99;
    if shadow == 0 then {
      return 12;
    }
  }
  let shadow: int = 6;
  while value < 8 {
    value += 1;
  }
  return value - shadow - 2;
}
