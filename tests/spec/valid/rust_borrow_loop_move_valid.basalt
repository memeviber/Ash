include "../../../src/stdlib/array.basalt"

func consume(move values: array::Array<int>): int {
  values = array::free(values);
  return 0;
}

func main(): int {
  let value: int = 4;
  let i: int = 0;
  while i < 5 {
    {
      let shared: int* = &value;
      if *shared != 4 then return 1;
    }
    i = i + 1;
  }
  {
    let mutable: int* = &mut value;
    *mutable = 8;
  }
  let values: array::Array<int> = array::new(2, 0);
  {
    let alias: int* = &value;
    if *alias != 8 then return 2;
  }
  consume(move values);
  return value - 8;
}

// diagnostic: valid
