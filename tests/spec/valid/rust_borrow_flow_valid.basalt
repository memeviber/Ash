func read_ref(borrow p: int*): int {
  return *p;
}

func write_ref(borrow_mut p: int*): int {
  *p = 19;
  return *p;
}

func main(): int {
  let value: int = 3;
  let other: int = 8;
  {
    let a: int* = &value;
    let b: int* = &value;
    if read_ref(a) != 3 then return 1;
    if *b != 3 then return 2;
  }
  if 1 then {
    let scoped: int* = &value;
    if *scoped != 3 then return 3;
  } else {
    let other_scoped: int* = &other;
    if *other_scoped != 8 then return 4;
  }
  let alias: int* = &value;
  alias = &other;
  if *alias != 8 then return 5;
  if write_ref(&mut value) != 19 then return 6;
  {
    let mutable_root: int* = &mut value;
    let child: int* = &mut *mutable_root;
    *child = 23;
    if *mutable_root != 23 then return 7;
  }
  return value - 23;
}

// diagnostic: valid
