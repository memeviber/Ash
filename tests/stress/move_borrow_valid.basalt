include "../../../src/stdlib/array.basalt"

func consume_owner(values: array::Array<int>): int {
  print array::get(values, 0);
  array::free(values);
  return 0;
}

func borrow_read(): int {
  let value: int = 7;
  {
    let first: int* = &value;
    let copied: int = *first;
    print copied;
  }
  value = 8;
  print value;
  return 0;
}

func move_owner(): int {
  let values: array::Array<int> = array::new(2, 0);
  values = array::push(values, 41, 0);
  print array::get(values, 0);
  consume_owner(values);
  return 0;
}

func main(): int {
  borrow_read();
  move_owner();
  return 0;
}
